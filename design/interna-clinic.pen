                },
                {
                  "type": "text",
                  "id": "jj2nL",
                  "name": "P",
                  "fill": "$black",
                  "textGrowth": "fixed-width",
                  "width": "fill_container",
                  "content": "ТОО «Interna Clinic» (далее — Клиника) в лице генерального директора Утегенова Асета Кедргалиевича, действующего на основании Устава, публикует настоящую оферту о заключении договора на оказание платных медицинских услуг на условиях, изложенных ниже.",
                  "lineHeight": 1.55,
                  "fontFamily": "$font",
                  "fontSize": 16,
