---
import SearchBar from '../components/SearchBar.astro';
import extra from '../data/services_extra.json';
const dirs = [...Object.entries(services).map(([k, v]) => [`/service/${k}`, v.t]), ...Object.entries(extra).map(([k, v]) => [`/uslugi/${k}`, v.t])].sort((a, b) => a[1].localeCompare(b[1], 'ru'));
import '../styles/global.css';
import '../styles/v2.css';
import services from '../data/services.json';
import { SITE, NAV, img } from '../lib/site.js';

interface Props { title: string; description?: string; lang?: string; theme?: string; active?: string; jsonld?: object; og?: string; }
const { title, description = 'Институт гастроэнтерологии, гепатологии и метаболизма в Алматы. Помогаем определить диагноз на первом приёме.', lang = 'ru', theme = '', active = '', jsonld, og = 'home' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const isKk = Astro.currentLocale === 'kk';
// Иконки Material Symbols — только используемые (параметр text=), иначе шрифт весит 3 МБ
const ICONS_CSS = "https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,400,0..1,0&display=block&icon_names=accessible,account_balance_wallet,add,alarm,animation,apartment,arrow_back,arrow_downward,arrow_forward,arrow_outward,assignment,attach_file,badge,bed,biotech,bookmark,bubble_chart,calendar_month,call,campaign,chat,chat_bubble,check,check_circle,checklist,chevron_right,child_care,clinical_notes,close,content_copy,credit_card,description,directions_bus,directions_car,diversity_3,download,endocrinology,event,event_available,event_note,expand_more,fact_check,folder_open,gastroenterology,gavel,grid_view,handshake,health_and_safety,health_metrics,height,help,home,hotel,how_to_reg,info,keyboard_arrow_down,keyboard_arrow_up,local_hospital,location_on,lock,mail,medical_services,medication,menu,monitor_heart,music_note,near_me,no_food,open_in_new,payments,pediatrics,person_search,photo_camera,picture_as_pdf,play_arrow,play_circle,print,radio_button_unchecked,radiology,receipt_long,remove,restaurant,schedule,school,search,sell,share,star,stethoscope,translate,upload_file,verified,verified_user,water_drop,waving_hand,work";
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');   // на GitHub Pages pathname содержит /interna-clinic
const ruPath = (basePath && Astro.url.pathname.startsWith(basePath) ? Astro.url.pathname.slice(basePath.length) : Astro.url.pathname).replace(/^\/kk(?=\/|$)/, '').replace(/^\/404\/?$/, '') || '/';
const org = {
  '@context': 'https://schema.org', '@type': 'MedicalClinic', name: SITE.name, url: Astro.site?.href,
  telephone: SITE.phone, email: SITE.email,
  address: { '@type': 'PostalAddress', streetAddress: 'ул. Богенбай батыра, 248', addressLocality: 'Алматы', addressCountry: 'KZ' },
  openingHours: ['Mo-Fr 08:00-22:00', 'Sa-Su 09:00-17:00'],
};
---
<!doctype html>
<html lang={Astro.currentLocale || lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="ru-KZ" href={new URL(ruPath, Astro.site).href} />
    <link rel="alternate" hreflang="kk-KZ" href={new URL('/kk' + (ruPath === '/' ? '/' : ruPath), Astro.site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(ruPath, Astro.site).href} />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0A2E45" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Interna Clinic" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(img(`og/${og}`), Astro.site).href} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href={ICONS_CSS} media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" /><link rel="stylesheet" href={ICONS_CSS} /></noscript>
    <style set:html={`:root{--logo:url(${img('logo')})}`} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonld || org)} />
  </head>
  <body class={theme}>
    <header class="hdr" id="hdr">
      <div class="shell">
        <div class="navcard">
          <a class="logo" href="/" aria-label="Interna Clinic"><span class="logo-mark"></span></a>
          <nav class="nav" id="nav">
            <div class="has-dd" id="ddWrap">
              <a href="/services" class={active === 'services' ? 'on' : ''}>Услуги <span class="msr">expand_more</span></a>
              <div class="dd" id="dd">
                <div class="shell dd-in">
                  <div class="dd-intro"><p class="kicker">Направления</p><h3>Услуги</h3><p>Диагностика и лечение ЖКТ, печени и эндокринной системы. Приём и обследование — в одной клинике.</p><a class="link" href="/services">Все услуги и цены <span class="msr ai">arrow_forward</span></a><div class="dd-info"><span><span class="msr">location_on</span>{SITE.address}</span><span><span class="msr">schedule</span>{SITE.hoursShort}</span></div></div>
                  <div class="dd-col"><h6>Направления</h6>
                    {Object.entries(services).map(([k, s]) => (
                      <a class="dd-item" href={`/service/${k}`}><span class="itile"><span class="msr">{s.icon}</span></span><span><b>{s.t}</b><small>{s.cat}</small></span><span class="price">{s.price}</span><span class="msr ai">arrow_outward</span></a>
                    ))}
                  </div>
                  <div class="dd-side"><h6>Программы</h6>
                    <a href="/checkup"><span class="msr">checklist</span>Check-up программы<span class="msr ch">chevron_right</span></a>
                    <a href="/kids"><span class="msr">pediatrics</span>Interna KIDS<span class="msr ch">chevron_right</span></a>
                    <a href="/prices"><span class="msr">payments</span>Цены<span class="msr ch">chevron_right</span></a>
                    <a href="/uslugi/station"><span class="msr">local_hospital</span>Стационар<span class="msr ch">chevron_right</span></a>
                    <div class="dd-promo"><p class="kicker on-dark">Check-up</p><b>Полное обследование за 1–2 дня</b><small>Пять программ от 91 113 ₸. Анализы, УЗИ, эндоскопия и заключение врача.</small><a class="btn btn-primary" href="/checkup">Подобрать программу</a></div>
                  </div>
                </div>
              </div>
            </div>
            {NAV.slice(1).map(([href, label]) => <a href={href} class={active === href.slice(1) ? 'on' : ''}>{label}</a>)}
          </nav>
          <div class="hdr-cta">
            {isKk ? <a class="lang" href={ruPath} hreflang="ru" data-lang-switch>RU</a> : <a class="lang" href={`/kk${ruPath === '/' ? '/' : ruPath}`} hreflang="kk" data-lang-switch>KZ</a>}
            <a class="hcall" href={SITE.phoneHref} aria-label="Позвонить"><span class="msr">call</span></a>
            <button class="hsearch" id="hsearch" aria-label="Поиск по сайту" title="Поиск"><span class="msr">search</span></button>
            <a class="hdr-phone" href={SITE.phoneHref}><b>{SITE.phone}</b><span class="hinfo" data-today data-wd="22:00" data-we="17:00">Алматы · сегодня до 22:00</span></a>
            <button class="btn btn-primary" data-book>Записаться на приём</button>
            <button class="burger" id="burger" aria-label="Меню"><span class="msr">menu</span></button>
          </div>
        </div>
      </div>
    </header>

    {/* Мобильное меню (макет 27 A): шапка с лого и иконками, «Услуги» раскрыты, основные пункты, второстепенные в две колонки, язык, кнопки, телефон */}
    <div class="mnav" id="mnav" role="dialog" aria-modal="true" aria-label="Меню">
      <div class="mn-hdr">
        <a class="logo" href="/" aria-label="Interna Clinic"><span class="logo-mark"></span></a>
        <div class="r">
          <a href={SITE.phoneHref} aria-label="Позвонить"><span class="msr">call</span></a>
          <button type="button" data-search-open aria-label="Поиск по сайту"><span class="msr">search</span></button>
          <button type="button" class="x" id="mnavX" aria-label="Закрыть"><span class="msr">close</span></button>
        </div>
      </div>
      <nav class="mn-nav">
        <details class="mn-svc" open>
          <summary>Услуги<span class="msr" aria-hidden="true">keyboard_arrow_down</span></summary>
          <div class="sub">
            {Object.entries(services).map(([k, s]) => <a href={`/service/${k}`}><span class="msr">{s.icon}</span>{s.t}</a>)}
            <a href="/checkup"><span class="msr">checklist</span>Check-up</a>
            <a href="/kids"><span class="msr">child_care</span>Interna KIDS</a>
            <a class="all" href="/services">Все услуги<span class="msr">arrow_forward</span></a>
          </div>
        </details>
        <a href="/doctors">Врачи<span class="msr" aria-hidden="true">chevron_right</span></a>
        <a href="/prices">Цены<span class="msr" aria-hidden="true">chevron_right</span></a>
        <a href="/checkup">Check-up<span class="msr" aria-hidden="true">chevron_right</span></a>
        <a href="/kids">Interna KIDS<span class="msr" aria-hidden="true">chevron_right</span></a>
        <a href="/contacts">Контакты<span class="msr" aria-hidden="true">chevron_right</span></a>
      </nav>
      <div class="mn-sec">
        <div><a href="/about">О клинике</a><a href="/patient">Пациенту</a><a href="/faq">Вопросы</a><a href="/vacancies">Вакансии</a></div>
        <div><a href="/media">Блог</a><a href="/news">Новости</a><a href="/promo">Акции</a><a href="/reviews">Отзывы</a></div>
      </div>
      <div class="mn-lang">
        <div class="seg2">
          <a class={isKk ? '' : 'on'} href={ruPath} hreflang="ru" data-lang-switch>Рус</a>
          <a class={isKk ? 'on' : ''} href={`/kk${ruPath === '/' ? '/' : ruPath}`} hreflang="kk" data-lang-switch>Қаз</a>
        </div>
        <span>Тіл · Язык</span>
      </div>
      <div class="mn-bot">
        <div class="b">
          <button type="button" class="btn btn-black" data-book><span class="msr">calendar_month</span>Записаться на приём</button>
          <a class="wa" href="#" data-wa="Здравствуйте! Пишу с сайта Interna Clinic." aria-label="Написать в WhatsApp"><span class="msr">chat</span></a>
        </div>
        <div class="ph"><a href={SITE.phoneHref}>{SITE.phone}</a><span>{SITE.hoursShort}</span><span>{SITE.address}</span></div>
      </div>
    </div>

    <div class="ddshade" aria-hidden="true"></div>
    <main id="app"><div class="page"><slot /></div></main>

    <footer>
      <div class="shell">
        <div class="top">
          <div class="fbrand">
            <a class="logo-plate" href="/" aria-label="Interna Clinic"><span class="logo-mark"></span></a>
            <p class="faddr">{SITE.address}</p>
            <p>{SITE.hoursShort}</p>
            <a class="ftel" href={SITE.phoneHref}>{SITE.phone}</a>
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
            <div class="fsoc">{SITE.social.map(([n, href, ic]) => <a href={href} target="_blank" rel="noopener" aria-label={n} title={n}><span class="msr">{ic}</span></a>)}</div>
          </div>
          <div><p class="fh">Пациентам</p><a href="#" data-book>Записаться онлайн</a><a href="/patient">Гид пациента</a><a href="/prepare">Подготовка к исследованиям</a><a href="/promo">Акции</a><a href="/faq">Вопросы и ответы</a><a href="/reviews">Отзывы</a></div>
          <div><p class="fh">Услуги</p><a href="/service/colonoscopy">Эндоскопия</a><a href="/service/gastro">Гастроэнтерология</a><a href="/service/fibroscan">Гепатология</a><a href="/service/ultrasound">УЗИ и диагностика</a><a href="/checkup">Check-up программы</a><a href="/uslugi/station">Стационар</a><a href="/kids">Interna KIDS</a><a href="/kids/shkola-diabeta-dlya-detei-i-roditelei">Школы для пациентов</a></div>
          <div><p class="fh">Клиника</p><a href="/about">О клинике</a><a href="/doctors">Врачи</a><a href="/about#equip">Оборудование</a><a href="/prices">Цены</a><a href="/contacts">Контакты</a><a href="/vacancies">Вакансии</a></div>
          <div><p class="fh">Новости и блог</p><a href="/media">Статьи</a><a href="/media?t=video">Видео</a><a href="/media?t=podcast">Подкасты</a><a href="/news">Новости и события</a><a href="/media?t=press">Пресса о нас</a></div>
        </div>
        <div class="flinks">
          <a href="#" data-book>Записаться на приём<span class="msr">arrow_forward</span></a>
          <a href="#" data-wa="Здравствуйте! Пишу с сайта Interna Clinic.">Написать в WhatsApp<span class="msr">arrow_forward</span></a>
          <a href={SITE.map2gis} rel="noopener" target="_blank">Открыть в 2ГИС<span class="msr">arrow_forward</span></a>
        </div>
        <div class="legal"><span>© {new Date().getFullYear()} {SITE.legalName} · БИН {SITE.bin} · Лицензия {SITE.license}. Имеются противопоказания, необходима консультация специалиста.</span><span><a href="/legal">Политика конфиденциальности</a><a href="/legal#offer">Оферта</a><a href="/legal#refund">Правила возврата</a><a href="/legal#consent">Согласие на обработку данных</a>{isKk ? <a href={ruPath} hreflang="ru" data-lang-switch>Русский · Қазақша</a> : <a href={`/kk${ruPath === '/' ? '/' : ruPath}`} hreflang="kk" data-lang-switch>Русский · Қазақша</a>}</span></div>
      </div>
    </footer>

    <div class="spanel" id="spanel" role="dialog" aria-modal="true" aria-label="Поиск по сайту">
      <div class="spanel-in">
        <div class="spanel-top"><b>Поиск по сайту</b><button class="x" id="spanelX" aria-label="Закрыть"><span class="msr">close</span></button></div>
        <SearchBar big popular={['Видеоколоноскопия', 'ЭГДС', 'Фиброскан', 'Гастроэнтеролог', 'Check-up', 'Цены']} />
        <p class="spanel-hint">Ищем по врачам, услугам, прайсу, детскому отделению и статьям. Enter — открыть первый результат.</p>
      </div>
    </div>
    <div class="fab"><button class="btn btn-deep" data-book><span class="msr">calendar_month</span>Записаться на приём</button></div>
    <div class="mcall"><a class="mcall-call" href={SITE.phoneHref} aria-label="Позвонить"><span class="msr">call</span></a><button class="btn btn-black" data-book>Записаться на приём</button></div>

    {/* Онлайн-запись (макет 17, на мобильном — нижний лист из макета 27 B) */}
    <div class="modal" id="modal" role="dialog" aria-modal="true" aria-labelledby="mtitle">
      <div class="mbox">
        <div id="mform">
          <div class="mhead">
            <div><p class="eyebrow">Онлайн-запись</p><h3 id="mtitle">Записаться на приём</h3></div>
            <button type="button" class="x" id="modalX" aria-label="Закрыть"><span class="msr">close</span></button>
          </div>
          <p class="sub">Администратор перезвонит или напишет в WhatsApp в рабочее время, чтобы подтвердить время.</p>
          <div class="mrow names">
            <div class="field"><label for="mName">Имя</label><input id="mName" placeholder="Как к вам обращаться" autocomplete="name" /></div>
            <div class="field"><label for="mPhone">Телефон</label><input id="mPhone" placeholder="+7 ___ ___ __ __" inputmode="tel" autocomplete="tel" /></div>
          </div>
          <div class="field"><label for="mSvc">Услуга или врач</label>
            <div class="sel"><select id="mSvc">{Object.values(services).map((s) => <option>{s.t}</option>)}<option>Check-up</option><option>Детский приём (KIDS)</option><option>Не знаю, нужна консультация</option></select><span class="msr" aria-hidden="true">keyboard_arrow_down</span></div></div>
          <div class="mrow">
            <div class="field"><label for="mDate">Дата</label><div class="sel"><input id="mDate" type="date" /><span class="msr" aria-hidden="true">calendar_month</span></div></div>
            <div class="field"><label for="mTime">Время</label><div class="sel"><select id="mTime"><option>Утро · 08:00–12:00</option><option>День · 12:00–17:00</option><option>Вечер · 17:00–22:00</option><option>Любое время</option></select><span class="msr" aria-hidden="true">keyboard_arrow_down</span></div></div>
          </div>
          <div class="field"><span class="lbl">Как связаться</span>
            <div class="mpick" id="mContact"><button type="button" class="on">WhatsApp</button><button type="button">Звонок</button></div></div>
          <label class="chk"><input type="checkbox" id="mAgree" /><span>Согласен(на) с <a href="/legal">политикой конфиденциальности</a> и обработкой персональных данных</span></label>
          <div class="mbtns">
            <button type="button" class="btn btn-deep" id="mSubmit">Отправить заявку</button>
            <a class="btn btn-wa" id="mWa" href="#" target="_blank" rel="noopener"><span class="msr">chat</span><span class="hide-d">Написать в WhatsApp</span><span class="hide-m">WhatsApp</span></a>
          </div>
          <p class="note">Заявка ни к чему не обязывает. Оплата — в клинике.</p>
        </div>
        <div id="mdone" hidden>
          <div class="done">
            <div class="ok"><span class="msr">check</span></div>
            <p class="eyebrow">Онлайн-запись</p>
            <h3>Заявка отправлена</h3>
            <p class="sub" id="mdoneTxt"></p>
            <p class="note">Администратор подтвердит время приёма.</p>
            <button type="button" class="btn btn-line" id="mClose2">Закрыть</button>
          </div>
        </div>
      </div>
    </div>

    <script set:html={`window.SITE_API=${JSON.stringify(import.meta.env.PUBLIC_API_URL || "")};window.LANG=${JSON.stringify(Astro.currentLocale || 'ru')};window.BASE=${JSON.stringify(import.meta.env.BASE_URL.replace(/\/$/, ''))};window.WA=${JSON.stringify(SITE.whatsapp)};`} />
    {/* Виджет Битрикс24 (открытые линии / CRM-формы): адрес скрипта задаётся при сборке — PUBLIC_BITRIX_WIDGET_URL */}
    {import.meta.env.PUBLIC_BITRIX_WIDGET_URL && <script async src={import.meta.env.PUBLIC_BITRIX_WIDGET_URL} />}
    {/* Яндекс.Метрика: номер счётчика задаётся при сборке — PUBLIC_YM_ID */}
    {import.meta.env.PUBLIC_YM_ID && <script set:html={`(function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};m[i].l=1*new Date();k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})(window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");ym(${JSON.stringify(import.meta.env.PUBLIC_YM_ID)},"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});`} />}
    <script defer src="/scripts/site.js"></script>
  </body>
</html>
