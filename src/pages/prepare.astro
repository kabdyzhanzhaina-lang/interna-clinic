---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import Faq from '../components/Faq.astro';
const TABS = ['Колоноскопия', 'ЭГДС', 'УЗИ брюшной полости', 'Фиброскан', 'Анализы'];
const DATA = [
  [['ЗА 3 ДНЯ', 'Диета без клетчатки', 'Исключите овощи, фрукты, хлеб грубого помола, орехи и грибы. Можно: бульон, яйца, рис, нежирное мясо и рыбу.'], ['НАКАНУНЕ', 'Приём препарата', 'Раствор по схеме, которую выдаст врач при записи. Последний приём пищи — за 18 часов, воду можно.'], ['В ДЕНЬ ПРОЦЕДУРЫ', 'Приезжайте натощак', 'Не есть и не пить за 4 часа. После седации нельзя за руль — планируйте сопровождение.']],
  [['НАКАНУНЕ', 'Лёгкий ужин', 'Ужин до 20:00, без жирного и тяжёлого.'], ['УТРОМ', 'Натощак', 'Не есть 8 часов, не пить 4 часа до процедуры. Лекарства — по согласованию с врачом.'], ['В ДЕНЬ', 'Документы и сопровождение', 'Возьмите прошлые заключения. После седации — сопровождающий.']],
  [['ЗА 2 ДНЯ', 'Без газообразующего', 'Исключите бобовые, капусту, газировку, чёрный хлеб.'], ['УТРОМ', 'Натощак', 'Не есть 6 часов до исследования, не пить за 1 час.'], ['В ДЕНЬ', 'Без подготовки', 'Щитовидная железа и сердце — подготовка не нужна.']],
  [['ШАГ 1', 'Без подготовки', 'Фиброскан не требует диеты и голодания. Желательно не есть 2–3 часа.'], ['ШАГ 2', '10 минут', 'Датчик прикладывается к правому боку — как при УЗИ.'], ['ШАГ 3', 'Сразу результат', 'Цифры фиброза и стеатоза с расшифровкой врача.']],
  [['УТРОМ', 'Натощак', 'Кровь сдаётся утром после 8–10 часов голода. Воду можно.'], ['ЗА СУТКИ', 'Без алкоголя и нагрузок', 'Исключите алкоголь, тяжёлые тренировки, баню.'], ['ЛЕКАРСТВА', 'Согласуйте с врачом', 'Некоторые препараты влияют на результаты — предупредите при записи.']],
];
const faq = [['Что будет, если подготовиться неправильно?', 'Врач может не рассмотреть слизистую полностью, и исследование придётся повторить. Поэтому мы дублируем памятку в WhatsApp и отвечаем на вопросы до процедуры.'], ['Можно ли пить воду?', 'Для эндоскопии — до 4 часов до процедуры, для УЗИ — можно.'], ['Что взять с собой?', 'Документ, результаты прошлых исследований, список лекарств. После седации — сопровождающего.'], ['Где взять препарат для подготовки?', 'Схему и название выдаст врач при записи, препарат продаётся в любой аптеке.']];
---
<Base title="Подготовка к процедурам — Interna Clinic" description="Пошаговые памятки: колоноскопия, ЭГДС, УЗИ, фиброскан, анализы. Памятка дублируется в WhatsApp при записи.">
  <PageHero crumbs={[['Главная', '/'], ['Пациентам', '/faq'], ['Подготовка']]} title="Подготовка к процедурам" sub="От качества подготовки зависит точность исследования. Выберите процедуру — покажем пошаговую памятку. Она же придёт вам в WhatsApp при записи." chips={['памятка — в WhatsApp', '5 шагов без сюрпризов']} />
  <section class="sec"><div class="shell">
    <div class="chips rv" id="preptabs">{TABS.map((t, i) => <button class={`chip${i === 0 ? ' on' : ''}`} data-prep={i}>{t}</button>)}</div>
    <div class="rv d2" style="margin-top:30px">
      {DATA.map((set, i) => <div class="grid3" data-prep-set={i} hidden={i !== 0}>{set.map((s, k) => <div class={`card bcard${k === 2 ? ' fill' : ''}`}><span class="tag" style={k === 2 ? 'background:var(--sky);color:var(--sky-dark)' : ''}>{s[0]}</span><h3 style="font-size:19px;margin:14px 0 8px">{s[1]}</h3><p>{s[2]}</p></div>)}</div>)}
    </div>
    <div class="warn rv d3" style="margin-top:22px"><i>!</i>Постоянно принимаете лекарства (антикоагулянты, препараты от диабета)? Обязательно скажите об этом при записи — врач скорректирует схему подготовки.</div>
  </div></section>
  <Faq items={faq} />
  <Cta />
</Base>
