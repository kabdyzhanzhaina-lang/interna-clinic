---
// Акции (макет 19 без блоков ОСМС/ГОБМП — клиника попросила убрать их с сайта): фото-хиро, действующие акции, CTA
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import SecHead from '../components/SecHead.astro';
import Cta from '../components/Cta.astro';
import promosFile from '../data/promos.json';
import { img, activePromos, untilLabel } from '../lib/site.js';
const promos = activePromos(promosFile.items);
---
<Base og="news" title="Акции Interna Clinic — специальные цены на обследования | Interna Clinic" description="Действующие акции Interna Clinic: специальные цены на эндоскопию, обследования и приёмы врачей." active="patient">
  <PhotoHero wide image="winter" eyebrow="Акции" title="Специальные цены клиники" sub="Действующие акции на обследования и приёмы врачей. Условия уточнит администратор при записи.">
    {promos.length > 0 && <a class="btn btn-ghost" href="#promo">Смотреть акции</a>}
  </PhotoHero>

  <section id="promo" style="padding:96px 0 96px"><div class="shell">
    <SecHead eyebrow="Акции" title={promos.length ? 'Действующие предложения' : 'Сейчас акций нет'} />
    {promos.length === 0 && <p class="lede">Новые акции появятся здесь. Узнать о специальных ценах можно у администратора по телефону или в WhatsApp.</p>}
    {promos.map((promo, i) => (
      <div class="promocard rv" style={i ? 'margin-top:24px' : undefined}>
        <div class="in"><span class="badge dark">{promo.off}</span><p class="kicker">{untilLabel(promo)}</p><h3>{promo.t}</h3><p>{promo.d}</p>
          <div class="pp"><span class="new">{promo.p}</span>{promo.old && <s>{promo.old}</s>}</div>
          <div class="btns"><button class="btn btn-dark" data-book data-svc={promo.t}>Записаться</button>{promo.link && <a class="btn btn-line" href={promo.link}>Об услуге <span class="msr ai">arrow_forward</span></a>}</div>
          <small>Имеются противопоказания, необходима консультация специалиста.</small>
        </div>
        <div class="img" style={`background-image:url(${img('sedation')})`}></div>
      </div>
    ))}
  </div></section>

  <Cta />
</Base>
