---
// Гид пациента (макет 11): плитки разделов, боковое оглавление, статьи с галочками и ссылками, CTA
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SideToc from '../components/SideToc.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../lib/site.js';
const tiles = [
  ['near_me', 'Как добраться', 'Богенбай батыра, 248', '#route'],
  ['badge', 'Первый визит', 'Документы и как проходит приём', '#first'],
  ['checklist', 'Подготовка', 'Памятки к исследованиям', '#prep'],
  ['hotel', 'Стационар', 'Госпитализация без очереди', '#stac'],
  ['description', 'Результаты и справки', 'Заключения, выписки, документы', '#docs'],
  ['child_care', 'С ребёнком', 'Детское отделение Interna KIDS', '#kids'],
  ['help', 'Вопросы и ответы', 'Частые вопросы пациентов', '/faq'],
];
const toc = [['Как добраться', '#route'], ['Первый визит', '#first'], ['Подготовка', '#prep'], ['Стационар', '#stac'], ['Результаты и справки', '#docs'], ['С ребёнком', '#kids']];
// Разделы гида: каждый — отдельная панель, внутри карточки (иконка, заголовок, короткий текст)
const sections = [
  { id: 'route', k: 'Как добраться', h: 'Адрес и часы работы', cards: [
    { i: 'location_on', t: SITE.address, d: 'Центральная клиника.' },
    { i: 'schedule', t: 'Часы работы', lines: SITE.hours.map(([d, h]) => `${d}: ${h}`) },
    { i: 'call', t: 'Запись', d: 'По телефону, в WhatsApp или онлайн на сайте.', tel: true },
  ], links: [[SITE.map2gis, 'Открыть в 2ГИС', true], ['/contacts', 'Карта и контакты']] },
  { id: 'first', k: 'Первый визит', h: 'Что взять с собой и как проходит приём', cards: [
    { i: 'badge', t: 'Удостоверение личности' },
    { i: 'folder_open', t: 'Медицинские документы', d: 'Результаты, выписки и заключения, если они есть.' },
    { i: 'event_available', t: 'Всё в одной клинике', d: 'Профильные специалисты и диагностика — в Interna Clinic.' },
  ] },
  { id: 'prep', k: 'Подготовка', h: 'Перед исследованием', lead: 'Видеоколоноскопия, ЭГДС, УЗИ брюшной полости и анализы требуют подготовки. Все памятки собраны в одном разделе.', cards: [
    { i: 'no_food', t: 'Натощак' },
    { i: 'restaurant', t: 'Диета накануне' },
    { i: 'water_drop', t: 'Препараты для очищения кишечника' },
    { i: 'chat', t: 'Вопросы по подготовке', d: 'Задайте администратору в WhatsApp.' },
  ], links: [['/prepare', 'Открыть памятки по подготовке']] },
  { id: 'stac', k: 'Стационар', h: 'Госпитализация', cards: [
    { i: 'how_to_reg', t: 'Без очереди', d: 'Платная госпитализация без направления, вне государственной очереди.' },
    { i: 'bed', t: 'Палата' },
    { i: 'monitor_heart', t: 'Наблюдение медперсонала' },
    { i: 'stethoscope', t: 'Обходы профессора' },
  ], links: [['/uslugi/station', 'Подробно о стационаре'], ['#', 'Записаться к гастроэнтерологу', false, 'Гастроэнтеролог']] },
  { id: 'docs', k: 'Результаты и справки', h: 'Заключения, выписки, документы', cards: [
    { i: 'clinical_notes', t: 'Заключение врача', d: 'С расшифровкой результатов — на очной консультации после готовности анализов.' },
    { i: 'description', t: 'Выписки и документы', d: 'Порядок получения уточните у администратора.' },
  ], links: [['#', 'Спросить в WhatsApp', false, null, 'Здравствуйте! Вопрос по результатам обследования или выписке.'], ['/legal', 'Оферта и правила возврата']] },
  { id: 'kids', k: 'С ребёнком', h: 'Interna KIDS', cards: [
    { i: 'child_care', t: 'Детские специалисты', d: 'Педиатр, детские гастроэнтеролог, эндокринолог, аллерголог и другие.' },
    { i: 'biotech', t: 'Обследования детям', d: 'Эндоскопия и фиброскан.' },
    { i: 'school', t: 'Школа диабета', d: 'Для семей.' },
    { i: 'schedule', t: 'Без очередей' },
  ], links: [['/kids', 'Детские направления']] },
];
---
<Base og="patient" title="Гид пациента — как добраться, первый визит, стационар | Interna Clinic" description="Практический гид пациента Interna Clinic: адрес и маршрут, что взять на первый визит, подготовка к исследованиям, госпитализация, результаты и справки." active="patient">
  <PageHero crumbs={[['Пациенту']]} title="Гид пациента" sub="Ответы на практические вопросы до визита: как найти клинику, что взять с собой, как подготовиться и как лечь в стационар." />

  <section style="padding:24px 0 0"><div class="shell"><div class="grid4 tiles">
    {tiles.map((t, i) => <a class={`tile rv d${(i % 4) + 1}`} href={t[3]}><span class="msr">{t[0]}</span><span><b>{t[1]}</b><small>{t[2]}</small></span></a>)}
  </div></div></section>

  <section style="padding:80px 0 96px"><div class="shell"><div class="lay">
    <SideToc w260 items={toc} card={{ title: 'Не нашли ответ?', text: 'Администратор ответит в WhatsApp в рабочее время.', btn: 'Написать', wa: 'Здравствуйте! У меня вопрос перед визитом в клинику.', line: true }} />
    <div class="main pguide pcards">
      {sections.map((sec) => (
        <article class="art rv" id={sec.id}>
          <div class="hd"><p class="kicker">{sec.k}</p><h2>{sec.h}</h2>{sec.lead && <p>{sec.lead}</p>}</div>
          <div class={`pc-grid${sec.cards.length === 5 ? ' n5' : ''}`} style={`--c:${sec.cards.length % 3 ? 4 : 3}`}>
            {sec.cards.map((c) => (
              <div class="pc"><span class="msr" aria-hidden="true">{c.i}</span><b>{c.t}</b>
                {c.d && <p>{c.d}</p>}
                {c.lines && c.lines.map((l) => <p>{l}</p>)}
                {c.tel && <a class="tel" href={SITE.phoneHref}>{SITE.phone}</a>}
              </div>
            ))}
          </div>
          {sec.links && <div class="links">{sec.links.map(([href, t, ext, svc, wa]) => <a class="link" href={href} rel={ext ? 'noopener' : undefined} target={ext ? '_blank' : undefined} data-book={svc ? true : undefined} data-svc={svc || undefined} data-wa={wa || undefined}>{t} <span class="msr">arrow_forward</span></a>)}</div>}
        </article>
      ))}
    </div>
  </div></div></section>

  <Cta title="Остались вопросы?" text="Позвоните или напишите — администратор подскажет, что взять с собой и как подготовиться." />
</Base>
