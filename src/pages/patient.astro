---
// Гид пациента (макет 11): плитки разделов, боковое оглавление, статьи с галочками и ссылками, CTA
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SideToc from '../components/SideToc.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../lib/site.js';
const tiles = [
  ['near_me', 'Как добраться', 'Богенбай батыра, 248 · парковка', '#route'],
  ['badge', 'Первый визит', 'Документы и как проходит приём', '#first'],
  ['checklist', 'Подготовка', 'Памятки к исследованиям', '#prep'],
  ['hotel', 'Стационар', 'Платно, по ГОБМП и ОСМС', '#stac'],
  ['verified', 'ОСМС и ГОБМП', 'Что можно пройти бесплатно', '#osms'],
  ['description', 'Результаты и справки', 'Заключения, выписки, документы', '#docs'],
  ['child_care', 'С ребёнком', 'Interna KIDS в том же здании', '#kids'],
  ['help', 'Вопросы и ответы', 'Частые вопросы пациентов', '/faq'],
];
const toc = [['Как добраться', '#route'], ['Первый визит', '#first'], ['Подготовка', '#prep'], ['Стационар', '#stac'], ['ОСМС и ГОБМП', '#osms'], ['Результаты и справки', '#docs'], ['С ребёнком', '#kids']];
---
<Base og="patient" title="Гид пациента — как добраться, первый визит, стационар, ОСМС | Interna Clinic" description="Практический гид пациента Interna Clinic: адрес и маршрут, что взять на первый визит, подготовка к исследованиям, госпитализация платно и по ОСМС/ГОБМП, результаты и справки." active="patient">
  <PageHero crumbs={[['Пациенту']]} title="Гид пациента" sub="Ответы на практические вопросы до визита: как найти клинику, что взять с собой, как подготовиться и как лечь в стационар." />

  <section style="padding:24px 0 0"><div class="shell"><div class="grid4 tiles">
    {tiles.map((t, i) => <a class={`tile rv d${(i % 4) + 1}`} href={t[3]}><span class="msr">{t[0]}</span><span><b>{t[1]}</b><small>{t[2]}</small></span></a>)}
  </div></div></section>

  <section style="padding:80px 0 96px"><div class="shell"><div class="lay">
    <SideToc w260 items={toc} card={{ title: 'Не нашли ответ?', text: 'Администратор ответит в WhatsApp за 10 минут в рабочее время.', btn: 'Написать', wa: 'Здравствуйте! У меня вопрос перед визитом в клинику.', line: true }} />
    <div class="main pguide">
      <article class="art rv" id="route"><p class="kicker">Как добраться</p><h2>Адрес и часы работы</h2>
        <p><b>{SITE.address}</b> — центральная клиника. Вход с улицы Богенбай батыра, ориентир — вывеска Interna Clinic.</p>
        <div class="bl">{SITE.hours.map(([d, h]) => <div class="b"><span class="msr">check_circle</span><span>{d}: {h}</span></div>)}</div>
        <p>Колл-центр работает в те же часы. Запись — по телефону <a href={SITE.phoneHref}>{SITE.phone}</a>, в WhatsApp или онлайн на сайте.</p>
        <div class="links"><a class="link" href={SITE.map2gis} rel="noopener" target="_blank">Открыть в 2ГИС <span class="msr">arrow_forward</span></a><a class="link" href="/contacts">Карта и контакты <span class="msr">arrow_forward</span></a></div>
      </article>

      <article class="art rv" id="first"><p class="kicker">Первый визит</p><h2>Что взять с собой и как проходит приём</h2>
        <div class="bl">
          <div class="b"><span class="msr">check_circle</span><span>Удостоверение личности. Для ребёнка — свидетельство о рождении и документ родителя.</span></div>
          <div class="b"><span class="msr">check_circle</span><span>Результаты прежних обследований, выписки и заключения, если они есть — врач учтёт их и не назначит лишнего.</span></div>
          <div class="b"><span class="msr">check_circle</span><span>Список лекарств, которые принимаете постоянно, с дозировками.</span></div>
          <div class="b"><span class="msr">check_circle</span><span>Направление из поликлиники — если идёте по ОСМС или ГОБМП.</span></div>
        </div>
        <p>Приходите за 10–15 минут до времени приёма: администратор оформит карту и проводит до кабинета. Приём и нужные обследования стараемся провести в один визит — заключение врача вы получаете на очной консультации.</p>
        <p>Приём ведётся на русском и казахском языках.</p>
      </article>

      <article class="art rv" id="prep"><p class="kicker">Подготовка</p><h2>Перед исследованием</h2>
        <p>Колоноскопия, ЭГДС, УЗИ брюшной полости и анализы требуют подготовки: натощак, диета накануне, препараты для очищения кишечника. Все памятки собраны в одном разделе, а при записи мы дублируем нужную в WhatsApp.</p>
        <div class="links"><a class="link" href="/prepare">Открыть памятки по подготовке <span class="msr">arrow_forward</span></a></div>
      </article>

      <article class="art rv" id="stac"><p class="kicker">Стационар</p><h2>Три вида госпитализации</h2>
        <div class="bl">
          <div class="b"><span class="msr">check_circle</span><span><b>Платно</b> — по решению лечащего врача, без очереди. Палата, наблюдение медперсонала, обходы профессора.</span></div>
          <div class="b"><span class="msr">check_circle</span><span><b>По ГОБМП</b> — бесплатно по направлению, в рамках государственной очереди: вирусные гепатиты B и C, цирроз печени, болезнь Крона и язвенный колит.</span></div>
          <div class="b"><span class="msr">check_circle</span><span><b>По ОСМС</b> — бесплатно для застрахованных, по направлению и в рамках очереди.</span></div>
        </div>
        <p><b>Что нужно для бесплатной госпитализации:</b> подтверждённый диагноз из поликлиники по месту жительства, заключение нашего гастроэнтеролога с подписью главного врача, обследования по перечню для вашего диагноза и регистрация в очереди через участкового врача в системе Damumed.</p>
        <div class="links"><a class="link" href="/uslugi/station">Подробно о стационаре <span class="msr">arrow_forward</span></a><a class="link" href="#" data-book data-svc="Гастроэнтеролог">Записаться к гастроэнтерологу <span class="msr">arrow_forward</span></a></div>
      </article>

      <article class="art rv" id="osms"><p class="kicker">ОСМС и ГОБМП</p><h2>Что можно пройти бесплатно</h2>
        <p><b>ГОБМП</b> — гарантированный объём бесплатной медицинской помощи для граждан Казахстана, кандасов и постоянно проживающих иностранцев. <b>ОСМС</b> — для тех, за кого уплачиваются взносы в фонд медстрахования, и льготных категорий.</p>
        <div class="bl">
          <div class="b"><span class="msr">check_circle</span><span>Эластометрия печени (фиброскан) — по направлению врача из поликлиники прикрепления.</span></div>
          <div class="b"><span class="msr">check_circle</span><span>Введение препаратов в процедурном кабинете при сахарном диабете с осложнениями, хроническом панкреатите и заболеваниях печени.</span></div>
          <div class="b"><span class="msr">check_circle</span><span>Госпитализация в круглосуточный стационар по перечню заболеваний.</span></div>
        </div>
        <div class="links"><a class="link" href="/promo">Все услуги по ОСМС <span class="msr">arrow_forward</span></a></div>
      </article>

      <article class="art rv" id="docs"><p class="kicker">Результаты и справки</p><h2>Заключения, выписки, документы</h2>
        <p>Заключение врача с расшифровкой результатов выдаётся на очной консультации после готовности анализов. Выписку из стационара, копии результатов и справки для работы или учёбы можно запросить у администратора — напишите в WhatsApp, документы подготовим к вашему визиту или пришлём электронно.</p>
        <div class="links"><a class="link" href="#" data-wa="Здравствуйте! Хочу получить результаты обследования или выписку.">Запросить документы в WhatsApp <span class="msr">arrow_forward</span></a><a class="link" href="/legal">Оферта и правила возврата <span class="msr">arrow_forward</span></a></div>
      </article>

      <article class="art rv" id="kids"><p class="kicker">С ребёнком</p><h2>Interna KIDS</h2>
        <p>Детское отделение: педиатр, детские гастроэнтеролог, эндокринолог, аллерголог и другие специалисты, эндоскопия и фиброскан детям, школа диабета для семей. Приём — в том же здании, без очередей.</p>
        <div class="links"><a class="link" href="/kids">Детские направления <span class="msr">arrow_forward</span></a></div>
      </article>
    </div>
  </div></div></section>

  <Cta title="Остались вопросы?" text="Позвоните или напишите — администратор подскажет, что взять с собой и как подготовиться." />
</Base>
