---
// Гид пациента: маршрут, первый визит, стационар, ОСМС/ГОБМП, документы. Факты — из данных клиники (контакты, страница стационара, free.json).
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../lib/site.js';
const toc = [['route', 'Как добраться'], ['first', 'Первый визит'], ['prep', 'Подготовка'], ['stac', 'Стационар'], ['osms', 'ОСМС и ГОБМП'], ['docs', 'Результаты и справки'], ['kids', 'С ребёнком']];
---
<Base title="Гид пациента — как добраться, первый визит, стационар, ОСМС | Interna Clinic" description="Практический гид пациента Interna Clinic: адрес и маршрут, что взять на первый визит, подготовка к исследованиям, госпитализация платно и по ОСМС/ГОБМП, результаты и справки." active="">
  <PageHero crumbs={[['Главная', '/'], ['Пациенту']]} title="Гид <em>пациента</em>" sub="Ответы на практические вопросы до визита: как найти клинику, что взять с собой, как подготовиться и как лечь в стационар." />

  <section class="sec" style="padding-top:36px"><div class="shell">
    <div class="pgrid">
      <aside class="ptoc rv"><p class="kicker">Разделы</p>{toc.map(([id, t]) => <a href={`#${id}`}>{t}</a>)}
        <div class="card" style="padding:18px;margin-top:18px"><b style="display:block;margin-bottom:6px">Не нашли ответ?</b><p style="margin:0 0 12px;font-size:14px">Администратор ответит в WhatsApp за 10 минут в рабочее время.</p><a class="btn btn-primary sm" href="#" data-wa="Здравствуйте! У меня вопрос перед визитом в клинику.">Написать в WhatsApp</a></div>
      </aside>

      <div class="pbody body">
        <article class="card rv" id="route"><p class="kicker">Как добраться</p><h2 class="h">Адрес и часы работы</h2>
          <p><b>{SITE.address}</b> — центральная клиника. Вход с улицы Богенбай батыра, ориентир — вывеска Interna Clinic.</p>
          <ul>{SITE.hours.map(([d, h]) => <li>{d}: {h}</li>)}</ul>
          <p>Колл-центр работает в те же часы. Запись — по телефону <a href={SITE.phoneHref}>{SITE.phone}</a>, в WhatsApp или онлайн на сайте.</p>
          <div class="row"><a class="btn btn-line sm" href={SITE.map2gis} rel="noopener">Открыть в 2ГИС</a><a class="btn btn-line sm" href="/contacts">Карта и контакты</a></div>
        </article>

        <article class="card rv" id="first"><p class="kicker">Первый визит</p><h2 class="h">Что взять с собой и как проходит приём</h2>
          <ul>
            <li>Удостоверение личности. Для ребёнка — свидетельство о рождении и документ родителя.</li>
            <li>Результаты прежних обследований, выписки и заключения, если они есть — врач учтёт их и не назначит лишнего.</li>
            <li>Список лекарств, которые принимаете постоянно, с дозировками.</li>
            <li>Направление из поликлиники — если идёте по ОСМС или ГОБМП.</li>
          </ul>
          <p>Приходите за 10–15 минут до времени приёма: администратор оформит карту и проводит до кабинета. Приём и нужные обследования стараемся провести в один визит — заключение врача вы получаете на очной консультации.</p>
          <p>Приём ведётся на русском и казахском языках.</p>
        </article>

        <article class="card rv" id="prep"><p class="kicker">Подготовка</p><h2 class="h">Перед исследованием</h2>
          <p>Колоноскопия, ЭГДС, УЗИ брюшной полости и анализы требуют подготовки: натощак, диета накануне, препараты для очищения кишечника. Все памятки собраны в одном разделе, а при записи мы дублируем нужную в WhatsApp.</p>
          <div class="row"><a class="btn btn-primary sm" href="/prepare">Открыть памятки по подготовке</a></div>
        </article>

        <article class="card rv" id="stac"><p class="kicker">Стационар</p><h2 class="h">Три вида госпитализации</h2>
          <ul>
            <li><b>Платно</b> — по решению лечащего врача, без очереди. Палата, наблюдение медперсонала, обходы профессора.</li>
            <li><b>По ГОБМП</b> — бесплатно по направлению, в рамках государственной очереди: вирусные гепатиты B и C, цирроз печени, болезнь Крона и язвенный колит.</li>
            <li><b>По ОСМС</b> — бесплатно для застрахованных, по направлению и в рамках очереди.</li>
          </ul>
          <p><b>Что нужно для бесплатной госпитализации:</b> подтверждённый диагноз из поликлиники по месту жительства, заключение нашего гастроэнтеролога с подписью главного врача, обследования по перечню для вашего диагноза и регистрация в очереди через участкового врача в системе Damumed.</p>
          <div class="row"><a class="btn btn-line sm" href="/uslugi/station">Подробно о стационаре</a><button type="button" class="btn btn-primary sm" data-book data-svc="Гастроэнтеролог">Записаться к гастроэнтерологу</button></div>
        </article>

        <article class="card rv" id="osms"><p class="kicker">ОСМС и ГОБМП</p><h2 class="h">Что можно пройти бесплатно</h2>
          <p><b>ГОБМП</b> — гарантированный объём бесплатной медицинской помощи для граждан Казахстана, кандасов и постоянно проживающих иностранцев. <b>ОСМС</b> — для тех, за кого уплачиваются взносы в фонд медстрахования, и льготных категорий.</p>
          <ul>
            <li>Эластометрия печени (фиброскан) — по направлению врача из поликлиники прикрепления.</li>
            <li>Введение препаратов в процедурном кабинете при сахарном диабете с осложнениями, хроническом панкреатите и заболеваниях печени.</li>
            <li>Госпитализация в круглосуточный стационар по перечню заболеваний.</li>
          </ul>
          <div class="row"><a class="btn btn-line sm" href="/promo">Все услуги по ОСМС</a></div>
        </article>

        <article class="card rv" id="docs"><p class="kicker">Результаты и справки</p><h2 class="h">Заключения, выписки, документы</h2>
          <p>Заключение врача с расшифровкой результатов выдаётся на очной консультации после готовности анализов. Выписку из стационара, копии результатов и справки для работы или учёбы можно запросить у администратора — напишите в WhatsApp, документы подготовим к вашему визиту или пришлём электронно.</p>
          <div class="row"><a class="btn btn-primary sm" href="#" data-wa="Здравствуйте! Хочу получить результаты обследования или выписку.">Запросить документы в WhatsApp</a><a class="btn btn-line sm" href="/legal">Оферта и правила возврата</a></div>
        </article>

        <article class="card rv" id="kids"><p class="kicker">С ребёнком</p><h2 class="h">Interna KIDS</h2>
          <p>Детское отделение: педиатр, детские гастроэнтеролог, эндокринолог, аллерголог и другие специалисты, эндоскопия и фиброскан детям, школа диабета для семей. Приём — в том же здании, без очередей.</p>
          <div class="row"><a class="btn btn-line sm" href="/kids">Детские направления</a></div>
        </article>
      </div>
    </div>
  </div></section>

  <Cta title="Остались <em>вопросы</em>?" text="Позвоните или напишите — администратор подскажет, что взять с собой и как подготовиться." />
</Base>
