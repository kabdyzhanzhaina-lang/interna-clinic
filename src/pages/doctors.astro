---
// Врачи (макет 04): хиро с поиском, чипами и алфавитом; список врачей в две колонки; «Показать ещё»; карточка «Не знаете, к кому?»; CTA
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SearchBar from '../components/SearchBar.astro';
import DocRow from '../components/DocRow.astro';
import Cta from '../components/Cta.astro';
import doctorsFile from '../data/doctors.json';
import { CATS } from '../lib/site.js';
const doctors = doctorsFile.items.filter((d) => !d.hidden);
const count = (k) => (k === 'all' ? doctors.length : doctors.filter((d) => d.cat === k).length);
const letters = [...new Set(doctors.map((d) => d.n[0].toUpperCase()))].sort((a, b) => a.localeCompare(b, 'ru'));
const SHOW = 12;
// первые SHOW врачей делим пополам между колонками, остальные (скрытые) — тоже пополам
const vis = doctors.slice(0, SHOW), rest = doctors.slice(SHOW);
const h1 = Math.ceil(vis.length / 2), h2 = Math.ceil(rest.length / 2);
const cols = [[...vis.slice(0, h1), ...rest.slice(0, h2)], [...vis.slice(h1), ...rest.slice(h2)]];
const isMore = (d) => doctors.indexOf(d) >= SHOW;
---
<Base og="doctors" title="Врачи Interna Clinic — гастроэнтерологи, эндокринологи, эндоскописты в Алматы" description="Кандидаты и доктора наук, профессура. Приём на русском и казахском языках. Запись онлайн." active="doctors">
  <PageHero crumbs={[['Врачи']]} title="Найти врача" sub={`${doctors.length} специалиста: кандидаты и доктора наук, профессура. Приём на русском и казахском языках — в одном здании на Богенбай батыра, 248.`}>
    <div class="rise d2" style="width:100%;display:flex;justify-content:center"><SearchBar dark placeholder="Фамилия, специальность или заболевание…" /></div>
    <div class="chips rise d3" id="docfilter">{Object.entries(CATS).map(([k, v], i) => <button class={`chip${i === 0 ? ' on' : ''}`} data-cat={k}>{v} {count(k)}</button>)}</div>
    <div class="az rise d3" id="docaz">{letters.map((l, i) => <a href={`#l-${l}`} class={i === 0 ? 'on' : ''} data-letter={l}>{l}</a>)}</div>
  </PageHero>

  <section style="padding:24px 0 0"><div class="shell">
    <div class="cols2 rv" id="docgrid">
      {cols.map((col, c) => <div class="doclist">{col.map((d, i) => <div class="docwrap" data-doc-cat={d.cat} data-letter={d.n[0].toUpperCase()} hidden={isMore(d) ? true : undefined} data-more={isMore(d) ? '' : undefined}><DocRow d={d} /></div>)}</div>)}
    </div>
    <div class="more-wrap rv" id="docmore" style="padding-top:40px;display:flex;justify-content:center"><button class="btn btn-line" type="button" id="docmoreBtn">Показать ещё {doctors.length - SHOW} врача</button></div>
  </div></section>

  <section style="padding:72px 0 96px"><div class="shell">
    <div class="getcard rv">
      <div class="l"><p class="kicker">Не знаете, к кому?</p><h2>Опишите жалобы — подберём врача за 10 минут</h2><p>Администратор уточнит симптомы, подскажет специалиста и свободное время. Если нужны обследования до приёма — объясним, какие.</p></div>
      <div class="b"><button class="btn btn-primary" data-book data-svc="Подобрать врача">Подобрать врача</button><a class="btn btn-wa" href="#" data-wa="Здравствуйте! Помогите подобрать врача."><span class="msr">chat</span>Написать в WhatsApp</a></div>
    </div>
  </div></section>

  <Cta title="Запишитесь на приём уже сегодня" text="Свободные окна есть в день обращения. Позвоните или оставьте заявку — подтвердим время за 10 минут." />
  <script is:inline>
    (function(){var btn=document.getElementById('docmoreBtn'),wrap=document.getElementById('docmore');if(!btn)return;
      var showAll=function(){document.querySelectorAll('#docgrid [data-more]').forEach(function(e){e.hidden=false;e.removeAttribute('data-more');});wrap.hidden=true;};
      btn.addEventListener('click',showAll);
      var f=document.getElementById('docfilter');if(f)f.addEventListener('click',function(e){if(e.target.closest('[data-cat]'))showAll();});
      var az=document.getElementById('docaz');if(az)az.addEventListener('click',function(e){var a=e.target.closest('[data-letter]');if(!a)return;e.preventDefault();showAll();az.querySelectorAll('a').forEach(function(x){x.classList.toggle('on',x===a);});
        var t=document.querySelector('#docgrid [data-letter="'+a.dataset.letter+'"]');if(t)t.scrollIntoView({behavior:'smooth',block:'center'});});
    })();
  </script>
</Base>
