---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Cta from '../../components/Cta.astro';
import articles from '../../data/articles.json';
import doctors from '../../data/doctors.json';
import { img } from '../../lib/site.js';

export function getStaticPaths() { return articles.map((a) => ({ params: { id: a.id } })); }
const a = articles.find((x) => x.id === Astro.params.id);
const d = doctors.find((x) => x.id === a.doc);
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', headline: a.t, author: { '@type': 'Person', name: a.by }, image: new URL(img(a.img), Astro.site).href };
---
<Base title={`${a.t} — Медиацентр Interna Clinic`} description={a.body[0][1].slice(0, 160)} active="media" jsonld={jsonld}>
  <PageHero crumbs={[['Главная', '/'], ['Медиацентр', '/media'], ['Статья']]} title={a.t} sub={`${a.by} · ${a.date} · ${a.min}`}>
    <span slot="extra" class="tag rise d3" style="background:rgba(255,255,255,.12);color:#fff;margin-top:14px;display:inline-block">{a.tag}</span>
  </PageHero>
  <section class="sec"><div class="shell"><div class="article">
    <article class="body rv"><div class="cover"><img src={img(a.img)} alt="" /></div>
      {a.body.map((b) => b[0] === 'h' ? <h3>{b[1]}</h3> : b[0] === 'q' ? <div class="pull">{b[1]}</div> : <p>{b[1]}</p>)}
    </article>
    <aside class="side rv d2">
      {d && <div class="card" style="padding:22px"><div style="display:flex;gap:14px;align-items:center"><div style="width:64px;height:64px;border-radius:50%;overflow:hidden;flex:none"><img src={img(d.img)} alt="" style="width:100%;height:100%;object-fit:cover;object-position:top" /></div><div><b style="color:var(--ink);font-size:15px;display:block;line-height:1.3">{d.n}</b><span style="font-size:12.5px;color:var(--faint);font-weight:600">{d.r}</span></div></div><button class="btn btn-primary" data-book style="width:100%;margin-top:16px">Записаться к автору</button></div>}
      <div class="toc"><b style="font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);display:block;margin-bottom:10px">Читайте также</b>{articles.filter((x) => x.id !== a.id).map((x) => <a href={`/article/${x.id}`}>{x.t}</a>)}</div>
    </aside>
  </div></div></section>
  <Cta />
</Base>
