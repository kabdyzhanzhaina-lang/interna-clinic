---
// Статья медиацентра v2 — редакционный лонгрид в духе The Blueprint с элементами, которые двигаются при скролле:
// полоса прогресса, призрачные номера разделов (параллакс), «плавающий факт», липкая рейка с процентом,
// пастельные пятна у цитат, липкий CTA после 600px прокрутки, каскадное появление «ещё по теме»
import Base from '../../layouts/Base.astro';
import Cta from '../../components/Cta.astro';
import { ALL_MEDIA as articles, fmtDate, excerpt } from '../../lib/media.js';
import doctorsFile from '../../data/doctors.json';
const doctors = doctorsFile.items.filter((d) => !d.hidden);
import { img } from '../../lib/site.js';

export function getStaticPaths() { return articles.map((a) => ({ params: { id: a.id } })); }
const a = articles.find((x) => x.id === Astro.params.id);
const d = a.doc ? doctors.find((x) => x.id === a.doc) : null;
const others = articles.filter((x) => x.id !== a.id).slice(0, 3);
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalWebPage', headline: a.t, author: { '@type': 'Organization', name: a.by }, image: new URL(img(a.img), Astro.site).href, datePublished: a.date };
let n = 0, firstP = true, factDone = false;
const toSec = (t) => t.split(':').reduce((acc, x) => acc * 60 + +x, 0);
const kind = a.tag.split(' · ')[0];
const topic = a.tag.split(' · ')[1] || 'Блог';
---
<Base og="media" title={`${a.t} — блог Interna Clinic`} description={excerpt(a, 160) || a.t} active="media" jsonld={jsonld}>
  <div class="readprog" id="readprog"></div>

  <section class="ahero">
    <div class="cover">{a.video ? <img src={img(a.img)} alt="" data-parallax="-0.2" /> : <img src={img(a.img)} alt="" data-parallax="-0.2" />}</div>
    <div class="toprow"><span>{kind} · {topic}</span><span>{fmtDate(a.date)}</span></div>
    <div class="shell">
      <nav class="crumbs rise d1" style="color:rgba(255,255,255,.8);font-size:12px;margin-bottom:24px"><a href="/" style="color:inherit">Главная</a><span>/</span><a href="/media" style="color:inherit">Блог</a><span>/</span><b style="color:#fff">{topic}</b></nav>
      <h1 class={`rise d2${a.t.length <= 36 ? ' short' : ''}`}>{a.t}</h1>
      <div class="ameta rise d3"><div><span>Автор</span>{a.by}</div><div><span>Рубрика</span>{topic}</div>{a.min && <div><span>Время</span>{a.min}</div>}</div>
    </div>
  </section>

  <section class="sec" style="padding-top:64px"><div class="shell"><div class="article ed">
    <aside class="arail" id="arail" aria-label="Прогресс чтения">
      <b>0%</b>
      <span class="track"><i></i></span>
      <button type="button" data-share aria-label="Поделиться"><span class="msr">share</span></button>
      <button type="button" data-book data-ask data-svc="Вопрос по статье" aria-label="Оставить вопрос"><span class="msr">chat_bubble</span></button>
    </aside>
    <article class="body abody rv">
      {a.video && <div class="acover" style="aspect-ratio:16/9;border-radius:20px;overflow:hidden;margin-bottom:32px"><iframe id="ytframe" data-video={a.video} src={`https://www.youtube-nocookie.com/embed/${a.video}`} title={a.t} loading="lazy" allowfullscreen style="width:100%;height:100%;border:0"></iframe></div>}
      {a.body.map((b) => {
        if (b[0] === 'h') { n += 1; const num = String(n).padStart(2, '0'); return <><span class="ghost" aria-hidden="true" data-parallax="0.18">{num}</span><h2 class="anum">{num} — {b[1]}</h2></>; }
        if (b[0] === 'h3') return <h3 class="asub">{b[1]}</h3>;
        if (b[0] === 'q') return <blockquote class="apull" data-parallax="0.04"><span class="blobl" data-parallax="-0.12"></span><span class="blobr" data-parallax="0.1"></span>{b[1]}</blockquote>;
        if (b[0] === 'ul') return <ul class="alist">{b[1].map((x) => <li>{x}</li>)}</ul>;
        if (b[0] === 'ol') return <ol class="alist">{b[1].map((x) => <li>{x}</li>)}</ol>;
        if (b[0] === 'tc') return <div class="tc"><b class="kicker">Содержание выпуска</b>{b[1].map(([t, l]) => <button type="button" data-seek={toSec(t)}><span>{t}</span>{l}</button>)}</div>;
        const cls = firstP ? 'lead-p' : ''; firstP = false;
        return <p class={cls}>{b[1]}</p>;
      })}
      {a.video && <p class="small" style="margin-top:28px;font-weight:600"><a class="btn btn-line sm" href={`https://www.youtube.com/watch?v=${a.video}`} target="_blank" rel="noopener">Смотреть на YouTube-канале клиники <span class="msr ai">open_in_new</span></a></p>}
      <div class="share"><span>Поделиться</span><a href="#" data-share>Скопировать ссылку</a><a href={`https://wa.me/?text=${encodeURIComponent(a.t)}`} target="_blank" rel="noopener">WhatsApp</a><a href={`https://t.me/share/url?url=&text=${encodeURIComponent(a.t)}`} target="_blank" rel="noopener" data-share-tg>Telegram</a></div>
      {d && <div class="author"><span class="ph">{d.img && <img src={img(d.img)} alt="" />}</span><span><b>{d.n}</b><small>{d.r}</small></span><button class="btn btn-primary sm" data-book data-ask data-svc="Вопрос по статье">Оставить вопрос</button></div>}
    </article>
    <aside class="side rv d2">
      <div class="card" style="padding:22px;margin-top:28px"><p class="kicker" style="font-size:17px">Есть вопрос по теме?</p><p style="margin:0 0 14px;font-size:14px;color:var(--g600)">Оставьте вопрос — администратор свяжется с вами в рабочее время.</p><button class="btn btn-primary sm" data-book data-ask data-svc="Вопрос по статье" style="width:100%">Оставить вопрос</button></div>
      <div class="toc" style="margin-top:28px"><b style="font-size:10px;letter-spacing:.18em;text-transform:uppercase;color:var(--g600);display:block;margin-bottom:12px">Читайте также</b>{others.map((x) => <a href={`/article/${x.id}`} style="display:block;font-size:14px;color:var(--black);padding:10px 0;border-top:1px solid var(--g200)">{x.t}</a>)}</div>
    </aside>
  </div></div></section>

  <section class="sec" style="padding-top:0"><div class="shell related">
    <p class="h">Читайте также</p>
    <div class="rgrid">{others.map((x, i) => <a class={`item rv d${i + 1}`} href={`/article/${x.id}`}><span class="img"><img src={img(x.img)} alt="" loading="lazy" /></span><span class="mcat">{x.tag.split(' · ').reverse().join(' • ')}</span><b class="t">{x.t}</b></a>)}</div>
  </div></section>

  <div class="stickycta" id="stickycta"><span><b>Есть вопрос по теме?</b><small>ответим в WhatsApp в рабочее время</small></span><button class="btn btn-primary sm" data-book data-ask data-svc="Вопрос по статье">Оставить вопрос</button></div>
  <Cta kicker="Вопрос врачу" title="Есть вопрос <em>к врачу</em>?" text="Оставьте вопрос — администратор свяжется с вами в рабочее время." btn="Оставить вопрос" svc="Вопрос по статье" ask />
</Base>
