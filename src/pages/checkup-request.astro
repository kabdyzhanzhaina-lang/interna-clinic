---
// Заявка на check-up (макет 07): форма 872 в рамке r24 p40 — прогресс «Шаг n из 5», пять нумерованных шагов
// (карточки программ 3×2 с радио, чипы 42px с галочкой, поля r12 54px, согласие, итог, кнопки); сайдбар 400:
// «Что будет после отправки», «Личный координатор»; FAQ в две колонки (свёрнут).
// Хуки public/scripts/site.js: #cuReq, .pick[data-pick][data-single] button[data-v], #cuName, #cuPhone, #cuAgree, #cuComment, #cuDate, #cuSubmit, #cuDone…
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Accordion from '../components/Accordion.astro';
import data from '../data/checkups.json';
import { SITE } from '../lib/site.js';
const { programs } = data;
const hot = (programs.find((p) => p.hot) || programs[0])?.id;
const goals = [['Профилактика, жалоб нет', 'ЖКТ: боли, вздутие, изжога', 'Печень: анализы, гепатит'], ['Сердце и сосуды', 'Гормоны и щитовидная железа', 'Вес и обмен веществ'], ['Наследственность: онкология', 'Перед операцией или беременностью']];
const steps = ['Программа', 'Формат', 'Что проверить', 'Когда', 'Контакты'];
const faq = [
  ['Можно ли собрать программу под себя?', 'Да. Профильные панели настраиваются под задачи check-up: координатор выясняет жалобы и цели.'],
  ['Сколько это займёт времени?', 'Большинство программ — 2–3 дня. Амбулаторно — без госпитализации, по согласованному графику; в стационаре — с пребыванием в палате и полным сопровождением.'],
  ['Нужно ли платить при заявке?', 'Нет. Это заявка координатору, а не онлайн-оплата.'],
];
// группы чипов: [ключ, подпись, подсказка, [варианты], выбранный]
const C = (k, l, h, vs, on) => ({ k, l, h, vs, on });
const g2 = [C('format', 'Формат', '', ['Амбулаторно', 'В стационаре'], 0), C('who', 'Для кого', '', ['Для себя', 'Для близкого'], 0), C('sex', 'Пол пациента', 'нужен для состава анализов', ['Женщина', 'Мужчина'], -1), C('age', 'Возраст пациента', '', ['до 30', '30–45', '45–60', '60+'], -1)];
const g4 = C('time', 'Время', '', ['Утро 08:00–12:00', 'День 12:00–17:00', 'Любое'], 0);
const g5 = C('channel', 'Как с вами связаться', '', ['WhatsApp', 'Звонок'], 0);
---
<Base og="checkup" active="checkup" title="Заявка на check-up — подобрать программу обследования | Interna Clinic" description="Заявка на check-up в Interna Clinic: программа, формат, что проверить и удобные даты. Координатор соберёт маршрут обследования.">
  <PageHero cta={false} crumbs={[['Check-up', '/checkup'], ['Заявка']]} title="Заявка на check-up" sub="Координатор выяснит жалобы и цели, подберёт программу и согласует день." />

  <section class="cq"><div class="shell"><div class="cq-wrap">
    <form class="cq-form rv" id="cuReq" novalidate>
      <div class="cq-prog" id="cuProg">
        <div class="r"><b>Шаг 1 из 5 · Программа</b><span>Заполнение займёт около 2 минут</span></div>
        <div class="bar">{steps.map((s, i) => <div class={i === 0 ? 'on' : ''}><i></i><span>{s}</span></div>)}</div>
      </div>

      <div class="cq-step" data-step="1">
        <div class="h"><span class="n">1</span><div><h3>Какая программа интересует</h3><p>Не уверены — нажмите «Не знаю».</p></div></div>
        <div class="pick progs" data-pick="program" data-single>
          {programs.map((p) => <button type="button" class={p.id === hot ? 'on' : ''} data-v={p.title}><span class="top"><b>{p.title}</b><span class="msr ic" aria-hidden="true">{p.id === hot ? 'check_circle' : 'radio_button_unchecked'}</span></span><span class="pz">{p.price}</span><small>{p.brief || p.sub}</small></button>)}
          <button type="button" class="unk" data-v="Не знаю — подобрать"><span class="top"><b>Не знаю</b><span class="msr ic" aria-hidden="true">help</span></span><span class="pz">помогите подобрать</span><small>Координатор предложит программу</small></button>
        </div>
      </div>

      <div class="cq-step" data-step="2">
        <div class="h"><span class="n">2</span><div><h3>Формат и для кого</h3><p>Для близкого — мы позвоним вам, а не пациенту.</p></div></div>
        {g2.map((g) => <div class="g"><div class="lr"><b>{g.l}</b>{g.h && <small>{g.h}</small>}</div><div class="pick" data-pick={g.k} data-single>{g.vs.map((v, i) => <button type="button" class={i === g.on ? 'on' : ''} data-v={v}>{i === g.on && <span class="msr">check</span>}{v}</button>)}</div></div>)}
      </div>

      <div class="cq-step" data-step="3">
        <div class="h"><span class="n">3</span><div><h3>Что важно проверить</h3><p>Можно выбрать несколько или ничего.</p></div></div>
        <div class="pick goals" data-pick="goals">{goals.flat().map((g) => <button type="button" class={g === 'ЖКТ: боли, вздутие, изжога' ? 'on' : ''} data-v={g}>{g === 'ЖКТ: боли, вздутие, изжога' && <span class="msr">check</span>}{g}</button>)}</div>
        <div class="g"><label class="lr" for="cuComment"><b>Жалобы, диагнозы, что уже обследовали</b></label><textarea id="cuComment" rows="3" placeholder="Например: год назад был гастрит, беспокоит вздутие; принимаю лекарства от давления"></textarea></div>
      </div>

      <div class="cq-step" data-step="4">
        <div class="h"><span class="n">4</span><div><h3>Когда удобно</h3><p>Дата ориентировочная: координатор подтвердит свободное окно.</p></div></div>
        <div class="g"><label class="lr" for="cuDate"><b>Желаемая дата</b></label><span class="inp"><input id="cuDate" type="text" inputmode="numeric" maxlength="10" placeholder="12.11.2026" autocomplete="off" /><span class="msr">calendar_month</span></span></div>
        {[g4].map((g) => <div class="g"><div class="lr"><b>{g.l}</b></div><div class="pick" data-pick={g.k} data-single>{g.vs.map((v, i) => <button type="button" class={i === g.on ? 'on' : ''} data-v={v}>{i === g.on && <span class="msr">check</span>}{v}</button>)}</div></div>)}
      </div>

      <div class="cq-step last" data-step="5">
        <div class="h"><span class="n">5</span><div><h3>Контакты</h3><p>Координатор свяжется в рабочее время: {SITE.hoursShort}.</p></div></div>
        <div class="r2">
          <div class="g"><label class="lr" for="cuName"><b>Имя</b><small>обязательно</small></label><span class="inp"><input id="cuName" placeholder="Как к вам обращаться" autocomplete="name" required /></span></div>
          <div class="g"><label class="lr" for="cuPhone"><b>Телефон</b><small>обязательно</small></label><span class="inp"><input id="cuPhone" placeholder="+7 ___ ___ __ __" inputmode="tel" autocomplete="tel" required /><span class="msr">call</span></span></div>
        </div>
        <div class="r2">
          {[g5].map((g) => <div class="g"><div class="lr"><b>{g.l}</b></div><div class="pick" data-pick={g.k} data-single>{g.vs.map((v, i) => <button type="button" class={i === g.on ? 'on' : ''} data-v={v}>{i === g.on && <span class="msr">check</span>}{v}</button>)}</div></div>)}
        </div>
        <label class="cq-agree"><input type="checkbox" id="cuAgree" /><span class="box"><span class="msr">check</span></span><span>Согласен(на) с <a href="/legal">политикой конфиденциальности</a> и обработкой персональных данных</span></label>
        <div class="cq-sum" id="cuSum"><span class="msr">fact_check</span><span class="t"><small>Вы выбрали</small><b id="cuSumTxt">Гастроэнтерологический Стандарт · амбулаторно · для себя · утром · ответ в WhatsApp</b></span><a href="#cuReq">Изменить</a></div>
        <div class="cq-btns">
          <button type="submit" class="btn btn-primary lg" id="cuSubmit">Отправить заявку<span class="msr">arrow_forward</span></button>
          <a class="btn btn-wa" href="#" data-wa="Здравствуйте! Хочу пройти check-up, помогите подобрать программу."><span class="msr">chat</span>Написать в WhatsApp</a>
          <span class="note"><span class="msr">info</span>Бесплатно и ни к чему не обязывает.</span>
        </div>
      </div>
    </form>

    <div class="cq-done" id="cuDone" hidden>
      <span class="ok"><span class="msr">check</span></span>
      <h3>Заявка принята</h3>
      <p class="sub" id="cuDoneTxt"></p>
      <p>Координатор ответит в рабочее время.</p>
      <div class="cq-btns"><a class="btn btn-primary" href="#" id="cuDoneWa" rel="noopener">Продублировать в WhatsApp</a><a class="btn btn-line" href="/checkup">К программам</a></div>
    </div>

    <aside class="cq-side">
      <div class="cq-next rv d1"><b class="t">Что будет после отправки</b>
        <div class="r"><span class="ci"><span class="msr">schedule</span></span><span class="i"><b>Связь</b><small>координатор пишет в WhatsApp или звонит в рабочее время</small></span></div>
        <div class="r"><span class="ci"><span class="msr">checklist</span></span><span class="i"><b>Уточняем</b><small>жалобы, цели, программу и день</small></span></div>
      </div>
      <div class="cq-coord rv d3"><p class="kicker">Личный координатор</p><b class="t">На каждом этапе обследования</b><p>Выясняет жалобы и цели, контролирует тайминг, собирает результаты и финальный пакет рекомендаций.</p><a class="btn btn-ghost" href={SITE.phoneHref}>{SITE.phone}</a></div>
    </aside>
  </div></div></section>

  <section class="cq-faq"><div class="shell">
    <div class="rv"><h2 class="h">Вопросы о заявке</h2></div>
    <div class="cols2 rv d2"><Accordion items={faq.slice(0, 2)} open={-1} /><Accordion items={faq.slice(2)} open={-1} /></div>
    <script type="application/ld+json" set:html={JSON.stringify({ '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((q) => ({ '@type': 'Question', name: q[0], acceptedAnswer: { '@type': 'Answer', text: q[1] } })) })} />
  </div></section>

  <script is:inline>
    // прогресс «Шаг n из 5 · Название» по видимому шагу, галочки/радио в чипах и карточках, строка «Вы выбрали»
    (function(){var f=document.getElementById('cuReq');if(!f)return;var steps=[].slice.call(f.querySelectorAll('.cq-step')),bar=[].slice.call(f.querySelectorAll('#cuProg .bar>div')),lbl=f.querySelector('#cuProg .r b'),sum=document.getElementById('cuSumTxt');
      function cur(){var y=innerHeight*0.4,i=0;steps.forEach(function(s,k){if(s.getBoundingClientRect().top<y)i=k;});bar.forEach(function(b,k){b.classList.toggle('on',k<=i);});lbl.textContent='Шаг '+(i+1)+' из '+steps.length+' · '+bar[i].querySelector('span').textContent;}
      function icons(){f.querySelectorAll('.pick:not(.progs) button').forEach(function(b){var on=b.classList.contains('on'),ic=b.querySelector('.msr');if(on&&!ic){ic=document.createElement('span');ic.className='msr';ic.textContent='check';b.insertBefore(ic,b.firstChild);}if(!on&&ic)ic.remove();});
        f.querySelectorAll('.pick.progs button:not(.unk)').forEach(function(b){b.querySelector('.ic').textContent=b.classList.contains('on')?'check_circle':'radio_button_unchecked';});}
      function upd(){var v=['program','format','who','time','channel'].map(function(k){var b=f.querySelector('[data-pick="'+k+'"] button.on');return b?b.dataset.v:'';}).filter(Boolean);var g=[].slice.call(f.querySelectorAll('[data-pick="goals"] button.on')).map(function(b){return b.dataset.v;});if(g.length)v.push(g.length+' '+(g.length===1?'цель':'цели'));sum.textContent=v.join(' · ')||'пока ничего — выберите программу выше';}
      addEventListener('scroll',cur,{passive:true});var dt=document.getElementById('cuDate');if(dt)dt.addEventListener('input',function(){var v=dt.value.replace(/\D/g,'').slice(0,8);dt.value=v.length>4?v.slice(0,2)+'.'+v.slice(2,4)+'.'+v.slice(4):v.length>2?v.slice(0,2)+'.'+v.slice(2):v;});f.addEventListener('click',function(){setTimeout(function(){icons();upd();},0);});cur();upd();})();
  </script>
</Base>
