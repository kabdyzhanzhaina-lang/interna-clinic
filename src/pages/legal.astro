---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE } from '../lib/site.js';
const toc = ['Публичная оферта', 'Политика конфиденциальности', 'Согласие на обработку ПД', 'Правила возврата средств', 'Реквизиты'];
---
<Base title="Документы — оферта, политика конфиденциальности | Interna Clinic" description="Публичная оферта, политика конфиденциальности и согласие на обработку персональных данных клиники Interna Clinic.">
  <PageHero crumbs={[['Главная', '/'], ['Документы'], ['Публичная оферта']]} title="Документы" sub="Публичная оферта, политика конфиденциальности и согласие на обработку персональных данных." />
  <section class="sec"><div class="shell"><div class="legalgrid">
    <div class="toc rv">{toc.map((t, i) => <a href={`#s${i + 1}`} class={i === 0 ? 'on' : ''}>{i + 1}. {t}</a>)}</div>
    <div class="body rv d2" style="max-width:74ch">
      <h3 id="s1" class="serif" style="font-size:26px;margin-bottom:12px">1. Публичная оферта</h3>
      <p style="font-size:15px;line-height:1.75;font-weight:500">{SITE.legalName}, именуемое в дальнейшем «Исполнитель», в лице Генерального директора, действующего на основании Устава и лицензии на занятие медицинской деятельностью {SITE.license}, выражает намерение заключить договор на оказание платных медицинских услуг с Заказчиками на условиях настоящей оферты.</p>
      <p style="font-size:15px;line-height:1.75;font-weight:500">1.1. Настоящий документ является публичной офертой в соответствии со статьёй 395 Гражданского кодекса Республики Казахстан.<br />1.2. Акцептом оферты считается запись на приём любым из доступных способов либо оплата услуг Исполнителя.<br />1.3. Актуальная редакция размещена на сайте internaclinic.kz и доступна в регистратуре.</p>
      <h3 id="s2" class="serif" style="font-size:26px;margin:32px 0 12px">2. Политика конфиденциальности</h3>
      <p style="font-size:15px;line-height:1.75;font-weight:500">Оператор обрабатывает персональные данные пациентов в соответствии с Законом Республики Казахстан «О персональных данных и их защите». Данные используются исключительно для оказания медицинских услуг, записи на приём и информирования о результатах. Передача третьим лицам без согласия субъекта не осуществляется.</p>
      <div class="pull">Тексты документов — заготовка структуры. Финальные формулировки предоставляет юрист клиники (бриф, раздел 9).</div>
      <h3 id="s5" class="serif" style="font-size:26px;margin:32px 0 12px">5. Реквизиты</h3>
      <p style="font-size:15px;line-height:1.75;font-weight:500">{SITE.legalName} · БИН {SITE.bin} · {SITE.address} · {SITE.email}</p>
    </div>
  </div></div></section>
</Base>
