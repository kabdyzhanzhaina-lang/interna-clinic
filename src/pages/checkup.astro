---
// Check-up (макет 06): фото-хиро, подменю, программы (сегменты + вертикальные вкладки + панель состава), как проходит, профильные программы, вопросы, CTA
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import SubNav from '../components/SubNav.astro';
import SecHead from '../components/SecHead.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import data from '../data/checkups.json';
import reviewsFile from '../data/reviews.json';
import { img } from '../lib/site.js';
const { programs, directions } = data;
const hot = (programs.find((p) => p.hot) || programs[0])?.id;
const count = (p) => p.groups.reduce((n, g) => n + g.items.filter((i) => i.in).length, 0);
const groupsOf = (p) => p.groups.map((g) => ({ title: g.title, items: g.items.filter((i) => i.in).map((i) => i.n) })).filter((g) => g.items.length);
// главное в программе: 3 пункта с главной (home.hi) или первые исследования приоритетных групп — остальное в «Полный состав»
const prio = [/консульт/i, /желуд|кишеч|печен/i, /сердц/i, /онко/i, /гормон/i, /инструмент/i, /лаборат/i, /витамин/i];
const rank = (t) => { const i = prio.findIndex((r) => r.test(t)); return i < 0 ? prio.length : i; };
const keyOf = (p) => p.home?.hi?.length ? p.home.hi : [...groupsOf(p)].sort((a, b) => rank(a.title) - rank(b.title)).map((g) => g.items[0]).slice(0, 4);
const steps = [['Заявка', 'Координатор уточняет жалобы и цели и подбирает программу.'], ['День 1', 'Лабораторные анализы, функциональная диагностика и УЗ-исследования.'], ['День 2', 'Эндоскопическое обследование и консультации профильных специалистов.'], ['Итоговое резюме', 'Врач сводит результаты в итоговое резюме по check-up: рекомендации по лечению, питанию и дальнейшему наблюдению.']];
const faq = [
  ['Сколько времени занимает check-up?', 'Большинство программ — 2–3 дня. В первый день — лабораторные анализы, функциональная диагностика и УЗ-исследования, во второй — эндоскопическое обследование и консультации профильных специалистов. Затем — итоговое резюме по check-up.'],
  ['Амбулаторно или в стационаре — в чём разница?', 'Амбулаторно — без госпитализации, по согласованному графику; в стационаре — с пребыванием в палате и полным сопровождением.'],
  ['На каком оборудовании проходит обследование?', 'На оборудовании экспертного класса: УЗИ — на аппаратах GE LOGIQ E10s и GE Versana Premier, печень — на FibroScan 630 Expert, состав тела — на анализаторе InBody 770.'],
  ['Какие эндоскопические стойки используются?', 'Видеоколоноскопия и ЭГДС проходят на эндоскопической системе Olympus EVIS X1. В ней внедрены новейшие технологии для точной диагностики предраковых состояний и заболеваний ЖКТ на ранних стадиях.'],
  ['Анализ InBody платный?', 'Нет. Анализ состава тела InBody входит во все программы check-up бесплатно.'],
  ['Можно ли изменить состав программы?', 'Да. Координатор выясняет жалобы и цели и настраивает профильные панели под ваш запрос.'],
];
// отзывы: отзывов именно о check-up в базе нет — показываем настоящие отзывы об обследованиях и оборудовании клиники
const revs = reviewsFile.items.filter((r) => /обследован|диагност|оборудован/i.test(r.text) && !/дёшев|дешев/i.test(r.text)).sort((a, b) => /обследован/i.test(b.text) - /обследован/i.test(a.text)).slice(0, 3);
const srcOf = (r) => (/2ГИС/i.test(r.src) ? '2ГИС' : /google/i.test(r.src) ? 'Google' : r.src);
const quote = (s, max = 170) => { if (s.length <= max) return s; const cut = s.slice(0, max); const i = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! ')); return i > 80 ? cut.slice(0, i + 1) : cut.replace(/\s+\S*$/, '') + '…'; };
const plural = (n, a, b, c) => { const m = n % 100, k = n % 10; return m > 10 && m < 20 ? c : k === 1 ? a : k > 1 && k < 5 ? b : c; };
const cnt = (n) => `${n} ${plural(n, 'исследование', 'исследования', 'исследований')}`;
// на телефоне программы — карточки с прокруткой вбок, над ними чипы с коротким названием
// анализ InBody входит во все программы бесплатно — помечаем в составе (просьба клиники)
const isFree = (x) => /InBody/.test(x);
const short = (t) => t.replace(/^Гастроэнтерологический /, 'Гастро ');
---
<Base og="checkup" title="Check-up программы в Алматы — полное обследование за 2–3 дня | Interna Clinic" description="5 программ check-up с полным составом и ценами: базовая, гастро стандарт и расширенный, премиум мужской и женский. Профильные программы: гастро, кардио, эндокринология, женское здоровье." active="checkup">
  <PhotoHero image="hero-checkup" pos="center 22%" eyebrow="Check-up" title="Полное обследование за 2–3 дня" sub="Полная картина здоровья без хождения по разным клиникам: анализы, УЗИ, эндоскопия и консультации специалистов — в одном месте, с личным координатором и итоговым резюме врача.">
    <a class="btn btn-ghost" href="#programs">Выбрать программу</a><a class="btn btn-ghost" href="/checkup-request">Оставить заявку</a>
  </PhotoHero>
  <SubNav items={[['Программы', '#programs'], ['Как проходит', '#how'], ['Профильные', '#dirs'], revs.length > 0 && ['Отзывы', '#reviews'], ['Вопросы', '#faq']].filter(Boolean)} />

  <section id="programs" style="padding:80px 0 0"><div class="shell cuex">
    <div class="cuhead rv"><SecHead eyebrow="Программы" title="Выберите программу" /></div>
    <div class="cupick rv d2" id="cuPick">
      <div class="vtabs">{programs.map((p) => <button type="button" class={`vtab${p.id === hot ? ' on' : ''}`} data-prog={p.id}><span class="n">{p.title}</span><span class="s">{short(p.title)}</span><span class="p">{p.price}</span><span class="msr">chevron_right</span></button>)}</div>
      <div class="cutrack" id="cuTrack">{programs.map((p) => <div class="cudet" data-det={p.id} hidden={p.id !== hot}>
        <div class="dh"><p class="kicker">{p.sub || 'Самая востребованная'}</p><h3>{p.title}</h3><p class="d">{p.desc || cnt(count(p))}</p></div>
        <div class="dp"><b>{p.price}</b></div>
        <div class="dk">{keyOf(p).map((x) => <span class="r"><span class="msr">check</span>{isFree(x) ? <span>{x} <span class="free">бесплатно</span></span> : x}</span>)}</div>
        <details class="dfull"><summary>Полный состав · {cnt(count(p))}<span class="msr">expand_more</span></summary><div class="dg">{groupsOf(p).map((g) => <div class="g"><span class="t">{g.title}</span>{g.items.map((x) => <span class="r"><span class="msr">check</span>{isFree(x) ? <span>{x} <span class="free">бесплатно</span></span> : x}</span>)}</div>)}</div></details>
        <div class="db"><a class="btn btn-primary" href="/checkup-request">Оставить заявку</a></div>
      </div>)}</div>
    </div>
  </div></section>

  <section id="how" style="padding:96px 0 0"><div class="shell">
    <div class="rv"><SecHead eyebrow="Как проходит" title="Большинство программ — за 2–3 дня" /></div>
    <div class="rv d2" style="margin-top:40px"><Steps items={steps} /></div>
  </div></section>


  <section id="dirs" style="padding:96px 0 0"><div class="shell">
    <div class="rv"><SecHead eyebrow="Профильные программы" title="Углублённая проверка по направлению" /></div>
    <div class="segm dseg rv d2" id="dirSeg">{directions.map((d, i) => <button type="button" class={i === 0 ? 'on' : ''} data-dir={d.id}>{d.name}</button>)}</div>
    {directions.map((d, i) => <div class="dirpanel" data-dirp={d.id} hidden={i !== 0}>
      <div class="dirintro rv">
        <div class="t">{d.intro.slice(0, 1).map((p) => <p>{p}</p>)}</div>
        {d.indications.length > 0 && <details class="ind" open><summary><b>Кому подходит</b><span class="msr">expand_more</span></summary><ul>{d.indications.map((x) => <li><span class="msr">check</span>{x}</li>)}</ul></details>}
      </div>
      <div class="dircards">{d.programs.map((p, j) => <article class={`dcard rv d${(j % 3) + 1}`}>
        <b class="t">{p.name}</b><span class="n">{cnt(p.items.length)}</span>
        <details><summary>Состав программы<span class="msr">expand_more</span></summary><ul>{p.items.map((x) => <li><span class="msr">check</span>{isFree(x) ? <span>{x} <span class="free">бесплатно</span></span> : x}</li>)}</ul>{p.note && <p class="note">{p.note}</p>}</details>
        <button type="button" class="btn btn-line" data-book data-svc={`Check-up · ${p.name}`}>Оставить заявку</button>
      </article>)}</div>
    </div>)}
  </div></section>

  {revs.length > 0 && <section class="revsec" id="reviews" style="padding:96px 0 0"><div class="shell">
    <SecHead eyebrow="Отзывы" title="Что говорят пациенты" link={['Все отзывы', '/reviews']} />
    <div class="revcards">{revs.map((r, i) => <article class={`rev rv d${i + 1}${i === 1 ? ' ice' : ''}`}>
      <div class="top"><span class="stars">{[0, 1, 2, 3, 4].map(() => <span class="msr">star</span>)}</span><span class={`src${srcOf(r) === '2ГИС' ? ' gis' : ''}`}>{srcOf(r)}</span></div>
      <p class="q">«{quote(r.text)}»</p>
      <div class="au"><span class="av">{r.name.trim()[0].toUpperCase()}</span><span><b>{r.name}</b><small>{srcOf(r)}</small></span></div>
    </article>)}</div>
  </div></section>}

  <section id="faq" style="padding:96px 0 0"><div class="shell"><Faq items={faq} kicker="Вопросы" title="Частые вопросы о check-up" /></div></section>

  <Cta title="Подобрать программу check-up" text="Координатор выяснит жалобы и цели и подберёт программу." btn="Оставить заявку" svc="Check-up" />

  <script is:inline>
    (() => {
      const pick = document.getElementById('cuPick'); if (!pick) return;
      const track = document.getElementById('cuTrack'); const mob = matchMedia('(max-width:700px)'); let syncing = true;
      const slide = (box, el, now) => box.scrollTo({ left: box.scrollLeft + el.getBoundingClientRect().left - box.getBoundingClientRect().left - 18, behavior: now ? 'instant' : 'smooth' });
      // чип прокручиваем, только если он не виден целиком
      const reveal = (box, el, now) => { const r = el.getBoundingClientRect(), b = box.getBoundingClientRect(); if (r.left < b.left + 18 || r.right > b.right - 18) slide(box, el, now); };
      // телефон: «Кому подходит» свёрнут
      if (mob.matches) document.querySelectorAll('.dirintro details.ind').forEach((d) => d.removeAttribute('open'));
      pick.addEventListener('click', (e) => {
        const b = e.target.closest('.vtab'); if (!b) return;
        pick.querySelectorAll('.vtab').forEach((x) => x.classList.toggle('on', x === b));
        pick.querySelectorAll('.cudet').forEach((d) => { d.hidden = d.dataset.det !== b.dataset.prog; });
        // телефон: все карточки в ленте — листаем к выбранной, чип — в видимую часть строки
        if (mob.matches) { const c = track.querySelector(`[data-det="${b.dataset.prog}"]`); if (c) slide(track, c, syncing); reveal(b.parentElement, b, syncing); }
      });
      // свайп ленты подсвечивает чип текущей программы
      let t;
      track.addEventListener('scroll', () => { clearTimeout(t); t = setTimeout(() => {
        if (!mob.matches) return;
        const x0 = track.getBoundingClientRect().left + 18;
        const cards = [...track.querySelectorAll('.cudet')];
        const i = cards.reduce((best, c, k) => (Math.abs(c.getBoundingClientRect().left - x0) < Math.abs(cards[best].getBoundingClientRect().left - x0) ? k : best), 0);
        const tab = pick.querySelectorAll('.vtab')[i];
        if (tab && !tab.classList.contains('on')) { pick.querySelectorAll('.vtab').forEach((x) => x.classList.toggle('on', x === tab)); cards.forEach((c, k) => { c.hidden = k !== i; }); reveal(tab.parentElement, tab); }
      }, 80); }, { passive: true });
      // ссылка /checkup#<id программы> (главная, раздел услуг) открывает эту программу
      const h = pick.querySelector(`.vtab[data-prog="${decodeURIComponent(location.hash.slice(1))}"]`);
      if (h) { h.click(); addEventListener('load', () => document.getElementById('programs').scrollIntoView({ behavior: 'instant' })); }
      else { const on = pick.querySelector('.vtab.on'); if (on) on.click(); }
      syncing = false;
      const ds = document.getElementById('dirSeg');
      if (ds) ds.addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; ds.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b)); document.querySelectorAll('.dirpanel').forEach((p) => { p.hidden = p.dataset.dirp !== b.dataset.dir; }); });
    })();
  </script>
</Base>
