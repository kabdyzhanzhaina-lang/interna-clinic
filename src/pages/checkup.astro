---
// Check-up (макет 06): фото-хиро, подменю, программы (сегменты + вертикальные вкладки + панель состава), как проходит, для компаний, профильные программы, вопросы, CTA
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import SubNav from '../components/SubNav.astro';
import SecHead from '../components/SecHead.astro';
import Steps from '../components/Steps.astro';
import Accordion from '../components/Accordion.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import data from '../data/checkups.json';
import { img } from '../lib/site.js';
const { programs, directions } = data;
const hot = (programs.find((p) => p.hot) || programs[0])?.id;
const count = (p) => p.groups.reduce((n, g) => n + g.items.filter((i) => i.in).length, 0);
const groupsOf = (p) => p.groups.map((g) => ({ title: g.title, items: g.items.filter((i) => i.in).map((i) => i.n) })).filter((g) => g.items.length).slice(0, 3);
const steps = [['Заявка', 'Оставляете заявку на сайте или в WhatsApp — координатор уточняет жалобы и цели и подбирает программу.'], ['Подготовка', 'Присылаем памятку: что взять с собой, как подготовиться к анализам, УЗИ и эндоскопии.'], ['Обследование', 'Утром натощак — анализы, УЗИ, функциональная диагностика и эндоскопия во сне. Всё в одном здании, без очередей.'], ['Заключение', 'Вечером или на следующий день — разбор результатов с профильным врачом и план наблюдения.']];
const faq = [
  ['Сколько времени занимает check-up?', 'Большинство программ проходят за 1–2 дня. В первый день — анализы, УЗИ, функциональная диагностика и эндоскопия при необходимости; во второй — консультации специалистов и разбор результатов.'],
  ['Амбулаторно или в стационаре — в чём разница?', 'Амбулаторно — приезжаете по согласованному графику, минимальный отрыв от работы. В стационаре — комфортная палата, сопровождение медперсонала, координация маршрута и обследования без ожидания.'],
  ['Нужна ли подготовка?', 'Прийти натощак для анализов и УЗИ брюшной полости. Подробную памятку пришлём в WhatsApp — см. раздел «Подготовка».'],
  ['Можно ли изменить состав программы?', 'Да. В каждой программе — личный координатор: выясняем жалобы и цели, профильные панели настраиваются под ваш запрос.'],
];
const dirItems = directions.map((d) => ({ q: d.name, a: [...d.intro, ...d.programs.map((p) => `${p.name}: ${p.items.join(', ').toLowerCase()}${p.note ? '. ' + p.note : ''}.`)], list: d.indications }));
---
<Base og="checkup" title="Check-up программы в Алматы — полное обследование за 1–2 дня | Interna Clinic" description="5 программ check-up с полным составом и ценами: базовая, гастро стандарт и расширенный, премиум мужской и женский. Профильные программы: гастро, кардио, эндокринология, женское здоровье." active="checkup">
  <PhotoHero image="hero" eyebrow="Check-up" title="Полное обследование за 1–2 дня" sub="Лаборатория, УЗИ, эндоскопия во сне и консультации профильных врачей — в одном здании, с личным координатором и заключением в тот же день.">
    <a class="btn btn-ghost" href="#programs">Выбрать программу</a><a class="btn btn-ghost" href="/checkup-request">Оставить заявку</a>
  </PhotoHero>
  <SubNav items={[['Программы', '#programs'], ['Как проходит', '#how'], ['Для компаний', '#corp'], ['Цены', '#programs'], ['Вопросы', '#faq']]} />

  <section id="programs" style="padding:80px 0 0"><div class="shell cuex">
    <div class="cuhead rv"><SecHead eyebrow="Программы" title="Выберите программу" /><div class="segm" id="cuSeg"><button type="button" class="on">Для него</button><button type="button">Для неё</button><button type="button">Детям</button></div></div>
    <div class="cupick rv d2" id="cuPick">
      <div class="vtabs">{programs.map((p) => <button type="button" class={`vtab${p.id === hot ? ' on' : ''}`} data-prog={p.id}><span class="n">{p.title}</span><span class="p">{p.price}</span><span class="msr">chevron_right</span></button>)}</div>
      {programs.map((p) => <div class="cudet" data-det={p.id} hidden={p.id !== hot}>
        <div class="dh"><p class="kicker">{p.sub || 'Самая востребованная'}</p><h3>{p.title}</h3><p class="d">{p.desc || `${count(p)} исследований и консультаций.`}</p></div>
        <div class="dp"><b>{p.price}</b><span>амбулаторно, от</span></div>
        <div class="dg">{groupsOf(p).map((g) => <div class="g"><span class="t">{g.title}</span>{g.items.slice(0, 4).map((x) => <span class="r"><span class="msr">check</span>{x}</span>)}</div>)}</div>
        <div class="db"><a class="btn btn-primary" href="/checkup-request">Оставить заявку</a><button type="button" class="btn btn-line" data-book data-svc={`Check-up · ${p.title}`}>Полный состав программы</button><span class="nt">{count(p)} исследований и консультаций · точный состав пришлёт координатор</span></div>
      </div>)}
    </div>
  </div></section>

  <section id="how" style="padding:96px 0 0"><div class="shell">
    <div class="rv"><SecHead eyebrow="Как проходит" title="Один день — и полная картина здоровья" /></div>
    <div class="rv d2" style="margin-top:40px"><Steps items={steps} /></div>
  </div></section>

  <section id="corp" style="padding:96px 0 0"><div class="shell">
    <div class="banner dark flip rv"><div class="img" style={`background-image:url(${img('team')})`}></div><div class="in"><p class="kicker">Для компаний</p><h3>Check-up для сотрудников — в удобный для бизнеса день</h3><p>Составим программу под возраст и задачи команды, примем группу за один день и пришлём обобщённый отчёт без персональных данных.</p><div class="btns"><a class="btn btn-ghost" href="#" data-wa="Здравствуйте! Хотим обсудить корпоративный check-up для сотрудников.">Обсудить корпоративный check-up</a></div></div></div>
  </div></section>

  <section id="dirs" style="padding:96px 0 0"><div class="shell">
    <div class="rv"><SecHead eyebrow="Профильные программы" title="Углублённая проверка по направлению" /></div>
    <div class="rv d2" style="margin-top:32px"><Accordion items={dirItems} /></div>
  </div></section>

  <section id="faq" style="padding:96px 0 0"><div class="shell"><Faq items={faq} kicker="Вопросы" title="Частые вопросы о check-up" /></div></section>

  <Cta title="Подобрать программу check-up" text="Оставьте заявку — координатор уточнит жалобы и цели, подберёт программу и пришлёт памятку по подготовке." btn="Оставить заявку" svc="Check-up" />

  <script is:inline>
    (() => {
      const pick = document.getElementById('cuPick'); if (!pick) return;
      pick.addEventListener('click', (e) => {
        const b = e.target.closest('.vtab'); if (!b) return;
        pick.querySelectorAll('.vtab').forEach((x) => x.classList.toggle('on', x === b));
        pick.querySelectorAll('.cudet').forEach((d) => { d.hidden = d.dataset.det !== b.dataset.prog; });
      });
      const seg = document.getElementById('cuSeg');
      if (seg) seg.addEventListener('click', (e) => { const b = e.target.closest('button'); if (!b) return; seg.querySelectorAll('button').forEach((x) => x.classList.toggle('on', x === b)); });
    })();
  </script>
</Base>
