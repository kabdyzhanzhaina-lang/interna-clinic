---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Cta from '../components/Cta.astro';
import services from '../data/services.json';
import extra from '../data/services_extra.json';
const groups = {};
for (const [slug, s] of Object.entries(extra)) (groups[s.cat] ||= []).push([slug, s]);
const order = ['Приём врача', 'Эндоскопические процедуры', 'УЗИ', 'Функциональная диагностика', 'Стационар', 'Interna KIDS'];
const total = Object.keys(services).length + Object.keys(extra).length;
---
<Base title="Услуги и направления — Interna Clinic" description="Все услуги клиники: приёмы врачей, эндоскопия, УЗИ, функциональная диагностика, стационар, check-up. Приём и обследования в один визит в Алматы." active="services">
  <PageHero crumbs={[['Главная', '/'], ['Услуги']]} title="Услуги и направления" sub="Диагностика и лечение заболеваний ЖКТ, печени и эндокринной системы. Приём и обследования — в один визит." chips={[`${total} услуг`, 'цены открыто']} />
  <section class="sec"><div class="shell">
    <div class="sec-head rv"><div><p class="kicker">Ключевые направления</p><h2 class="h">С чего <em>начать</em></h2></div></div>
    <div class="grid3">{Object.entries(services).map(([k, s], i) => <ServiceCard slug={k} s={s} delay={(i % 3) + 1} />)}</div>
  </div></section>
  {order.filter((c) => groups[c]).map((cat) => (
    <section class="sec" style="padding-top:0"><div class="shell">
      <div class="sec-head rv" style="margin-bottom:22px"><div><p class="kicker">{cat}</p><h2 class="h" style="font-size:clamp(22px,3vw,30px)">{cat}</h2></div><span class="tag">{groups[cat].length}</span></div>
      <div class="grid3">{groups[cat].map(([slug, s], i) => (
        <a class={`card bcard rv d${(i % 3) + 1}`} href={`/uslugi/${slug}`} style="padding:22px 22px 20px"><div style="display:flex;gap:12px;align-items:center"><span class="itile"><span class="msr">{s.icon}</span></span><h3 style="font-size:16.5px;margin:0">{s.t}</h3></div><p style="margin-top:10px;font-size:13.5px">{(s.description || s.lead || '').slice(0, 110)}{(s.description || s.lead || '').length > 110 ? '…' : ''}</p><span class="more" style="margin-top:12px;display:inline-flex">Подробнее →</span></a>
      ))}</div>
    </div></section>
  ))}
  <section class="sec" style="padding-top:0"><div class="shell"><div class="grid3">
    <a class="card bcard rv d1" href="/checkup"><div class="ic">⭐</div><h3>Check-up программы</h3><p>Женский, мужской, гастро, кардио, эндокринный — готовые комплексы обследования за один день.</p></a>
    <a class="card bcard rv d2" href="/kids"><div class="ic">🧸</div><h3>Interna KIDS</h3><p>Детское отделение: гастроэнтеролог, эндокринолог, педиатрические check-up.</p></a>
    <a class="card bcard rv d3" href="/prices"><div class="ic">💳</div><h3>Полный прайс</h3><p>Все позиции с ценами и живым поиском.</p></a>
  </div></div></section>
  <Cta />
</Base>
