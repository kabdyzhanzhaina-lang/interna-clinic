---
// Услуги (макет 02): хиро с поиском и чипами, 4 карточки-фото, каталог с боковым оглавлением, баннер KIDS, CTA
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SearchBar from '../components/SearchBar.astro';
import SideToc from '../components/SideToc.astro';
import Cta from '../components/Cta.astro';
import services from '../data/services.json';
import extra from '../data/services_extra.json';
import prices from '../data/prices.json';
import checkupsFile from '../data/checkups.json';
import { img, priceRank } from '../lib/site.js';
import { uslugiPrices } from '../lib/uslugi-prices.js';

const total = Object.values(prices).reduce((a, v) => a + v.length, 0);
// разделы прайса — как в документе клиники; группа каталога и чип собирают несколько разделов
const SEC = Object.keys(prices);
const kidsSec = SEC.filter((k) => /детского|педиатра/.test(k));
const recSec = SEC.filter((k) => /^Услуги /.test(k) && !/процедурного|стационара/.test(k) && !kidsSec.includes(k));
const chipMap = [['Приёмы', recSec], ['Эндоскопия', ['Эндоскопические исследования']], ['УЗИ и УЗДГ', ['Ультразвуковое исследование', 'УЗДГ сосудов']], ['Фиброскан', ['Непрямая эластография печени']], ['Рентген', ['Рентген диагностика']], ['Стационар', ['Услуги стационара без учёта медикаментов']], ['Процедурный', ['Услуги процедурного кабинета']], ['KIDS', kidsSec]];
const nRows = (ks) => ks.reduce((a, k) => a + (prices[k]?.length || 0), 0);
const cuProgs = checkupsFile.programs;
const chips = [['Все', total, '#catalog'], ...chipMap.map(([l, ks]) => [l, nRows(ks), `/prices#${encodeURIComponent(ks[0])}`])];
chips.splice(2, 0, ['Check-up', cuProgs.length, '/checkup']);

const featured = ['colonoscopy', 'fgds', 'fibroscan', 'ultrasound'].map((k) => [k, services[k]]);
const featTitle = { colonoscopy: 'Видеоколоноскопия во сне', fgds: 'ЭГДС (гастроскопия)', fibroscan: 'Фиброскан печени', ultrasound: 'УЗИ и ЭхоКГ' };

// группы каталога: основные услуги (с коротким описанием) + перенесённые страницы и позиции прайса (только название и цена)
// pr — строка прайса, чья цена показана у страницы: эту строку не дублируем ниже позицией прайса.
// Процедурный кабинет — раздел из многих услуг: без одной цены (первая строка — аллергопроба 330 ₸) и в своей группе, а не в «Стационаре»; хирургические манипуляции — в группе своего раздела прайса, а не в приёмах
const all = [...Object.entries(services).map(([k, s]) => ({ href: `/service/${k}`, t: s.t, d: s.short, price: s.price, cat: s.cat })), ...Object.entries(extra).map(([k, s]) => { const pr = k === 'proccab' ? null : uslugiPrices(k)[0]; return { href: `/uslugi/${k}`, t: s.t, d: '', price: pr?.[2] || '', pr: pr?.[0], cat: { proccab: 'Процедурный кабинет', surgeon: 'Хирургические манипуляции' }[k] || s.cat }; }), { href: '/uslugi/station#diagnostic', t: 'Диагностический стационар', d: '', price: (prices['Услуги стационара без учёта медикаментов'].find((r) => /check-up/.test(r[0])) || [])[2] || '', cat: 'Стационар' }];
const groupDefs = [
  ['reception', 'Приёмы врачей', ['Приём', 'Приём врача'], recSec],
  ['checkup', 'Check-up программы', [], []],
  ['endoscopy', 'Эндоскопия', ['Эндоскопия', 'Эндоскопические процедуры'], ['Эндоскопические исследования']],
  ['uzi', 'УЗИ и УЗДГ', ['Диагностика', 'УЗИ'], ['Ультразвуковое исследование', 'УЗДГ сосудов', 'Непрямая эластография печени']],
  ['func', 'Функциональная диагностика', ['Функциональная диагностика'], ['Мониторинг глюкозы']],
  ['xray', 'Рентген диагностика', [], ['Рентген диагностика']],
  ['station', 'Стационар', ['Стационар'], ['Услуги стационара без учёта медикаментов']],
  ['lab', 'Лабораторные анализы', [], ['Лабораторные анализы']],
  ['proc', 'Процедурный кабинет', ['Процедурный кабинет'], ['Услуги процедурного кабинета']],
  ['surg', 'Хирургические манипуляции', ['Хирургические манипуляции'], ['Хирургические манипуляции']],
  ['kids', 'Interna KIDS', ['Interna KIDS'], kidsSec],
];
// раздел check-up — программы клиники из checkups.json (не позиции прайса «Комплексы», просьба клиники)
const groups = groupDefs.map(([id, title, cats, pks]) => {
  if (id === 'checkup') return { id, title, count: cuProgs.length, rows: cuProgs.map((p) => ({ href: `/checkup#${p.id}`, t: `Check-up «${p.title}»`, d: p.sub || '', price: p.price })), href: '/checkup', word: cuProgs.length % 10 === 1 && cuProgs.length % 100 !== 11 ? 'программа' : [2, 3, 4].includes(cuProgs.length % 10) ? 'программы' : 'программ' };
  const items = all.filter((x) => cats.includes(x.cat));
  // порядок как в прайсе: по алфавиту, позиции без цены — в конце
  const priceRows = pks.flatMap((k) => (prices[k] || []).map((r) => [...r, k])).slice().sort((x, y) => (/\d/.test(y[2]) - /\d/.test(x[2])) || priceRank(x[0]) - priceRank(y[0]) || x[0].localeCompare(y[0], 'ru', { sensitivity: 'base' }));
  // добавляем позиции прайса, если в группе мало страниц услуг
  const fromPrice = items.length < 4 ? priceRows.filter((r, j) => /\d/.test(r[2]) && priceRows.findIndex((q) => q[0] === r[0]) === j && !items.some((i) => i.t.toLowerCase() === r[0].toLowerCase() || i.pr === r[0])).slice(0, 5 - items.length).map((r) => ({ href: `/prices#${encodeURIComponent(r[4])}`, t: r[0], d: '', price: r[2], cat: r[4] })) : [];
  // по алфавиту, как прайс (просьба клиники); check-up выше — по уровню программ
  const rows = [...items, ...fromPrice].sort((x, y) => priceRank(x.t) - priceRank(y.t) || x.t.localeCompare(y.t, 'ru', { sensitivity: 'base' }));
  return { id, title, count: priceRows.length || rows.length, rows, href: `/prices#${encodeURIComponent(pks[0])}` };
}).filter((g) => g.rows.length);
const plural = (n) => (n % 10 === 1 && n % 100 !== 11 ? 'услуга' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'услуги' : 'услуг');
---
<Base og="services" title="Услуги и направления — Interna Clinic" description="Все услуги клиники: приёмы врачей, эндоскопия, УЗИ, функциональная диагностика, стационар, check-up в Алматы." active="services">
  <PageHero crumbs={[['Услуги']]} title="Услуги и направления" sub="Диагностика и лечение заболеваний ЖКТ, печени и эндокринной системы.">
    <div class="rise d2" style="width:100%;display:flex;justify-content:center"><SearchBar dark placeholder="Найти услугу, симптом или врача…" /></div>
    <div class="chips rise d3">{chips.map(([l, n, href], i) => <a class={`chip${i === 0 ? ' on' : ''}`} href={href}>{l} {n}</a>)}</div>
  </PageHero>

  <section style="padding:24px 0 0"><div class="shell"><div class="feat4">
    {featured.map(([k, s], i) => <a class={`imgcard rv d${i + 1}`} href={`/service/${k}`}><span class="bg" style={`background-image:url(${img(s.img)})`}></span><span class="pr">{s.price}</span><b>{featTitle[k]}</b></a>)}
  </div></div></section>

  <section id="catalog" style="padding:72px 0 96px"><div class="shell"><div class="lay">
    <SideToc items={groups.map((g) => [g.title, `#${g.id}`])} card={{ title: 'Не знаете, к кому записаться?', text: 'Опишите жалобы — администратор подберёт врача и обследования.', btn: 'Написать в WhatsApp', wa: 'Здравствуйте! Не знаю, к какому врачу записаться. Помогите подобрать.' }} />
    <div class="main svcgroups">
      {groups.map((g) => (
        <div class="svcgroup" id={g.id}>
          <div class="gh rv"><div class="tt"><h3>{g.title}</h3><span class="cnt">{g.count} {g.word || plural(g.count)}</span></div><a class="link" href={g.href}>Все в разделе <span class="msr">arrow_forward</span></a></div>
          {g.rows.map((r, i) => <a class={`srow rv d${(i % 5) + 1}`} href={r.href}><span class="i"><b>{r.t}</b>{r.d && <small>{r.d}</small>}</span>{r.price && <span class="pr">{r.price}</span>}<span class="msr ai">arrow_forward</span></a>)}
        </div>
      ))}
    </div>
  </div></div></section>

  <section style="padding:0 0 96px"><div class="shell">
    <div class="banner rv"><div class="in"><p class="kicker">Interna KIDS</p><h3>Детское отделение Interna KIDS</h3><p>Педиатр, детские гастроэнтеролог и эндокринолог, эндоскопия и фиброскан детям.</p><div class="btns"><a class="btn btn-dark" href="/kids">Детские направления</a><a class="btn btn-line" href="/kids/shkola-diabeta-dlya-detei-i-roditelei">Школа диабета</a></div></div><div class="img" style={`background-image:url(${img('heart')})`}></div></div>
  </div></section>

  <Cta title="Не нашли нужную услугу?" text="Позвоните или напишите — администратор подскажет, есть ли услуга в клинике." />
</Base>
