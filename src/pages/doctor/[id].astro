---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import Cta from '../../components/Cta.astro';
import doctors from '../../data/doctors.json';
import Body from '../../components/Body.astro';
import prices from '../../data/prices.json';
import { img } from '../../lib/site.js';

export function getStaticPaths() { return doctors.map((d) => ({ params: { id: d.id } })); }
const d = doctors.find((x) => x.id === Astro.params.id);
const rel = doctors.filter((x) => x.cat === d.cat && x.id !== d.id).slice(0, 4);
// позиции прайса, где в подписи указан этот врач
const key = d.n.toLowerCase().split(' ').slice(0, 2).join(' ');
const rows = []; for (const k in prices) for (const r of prices[k]) if ((r[1] || '').toLowerCase().includes(key) && !rows.some((x) => x[0] === r[0])) rows.push(r);
const expLabel = d.exp ? (/^практика/.test(d.exp) ? d.exp : `стаж ${d.exp}`) : '';
const jsonld = { '@context': 'https://schema.org', '@type': 'Physician', name: d.n, jobTitle: d.r, description: d.bio, image: new URL(img(d.img), Astro.site).href, worksFor: { '@type': 'MedicalClinic', name: 'Interna Clinic' } };
---
<Base title={`${d.n} — ${d.r} | Interna Clinic`} description={d.bio} active="doctors" jsonld={jsonld}>
  <PageHero crumbs={[['Главная', '/'], ['Врачи', '/doctors'], [d.n.split(' ')[0]]]} title={d.n} sub={d.r}>
    <div slot="extra">
      <div class="chips rise d3" style="margin-top:22px">{d.tags.map((t) => <span class="chip" style="background:rgba(255,255,255,.12);color:#fff">{t}</span>)}{expLabel && <span class="chip" style="background:rgba(255,255,255,.12);color:#fff">{expLabel}</span>}</div>
      <div class="hero-actions rise d4"><button class="btn btn-sky" data-book data-svc={`Приём · ${d.n}`}>Записаться к врачу</button></div>
    </div>
    <div slot="right" class="phero-img rise d2" style="aspect-ratio:.85;max-width:380px;margin-left:auto"><img src={img(d.img)} alt={d.n} style="object-position:top" /></div>
  </PageHero>
  <section class="sec"><div class="shell"><div class="article">
    <article class="body card rv" style="padding:34px 38px"><h3 class="serif" style="font-size:24px;margin:0 0 14px">О враче</h3><p style="margin:0 0 22px;font-size:16px;line-height:1.7;font-weight:500">{d.bio}</p>
      {d.about && d.about.length > 0 && <div class="dbio"><Body body={d.about} /></div>}
    </article>
    <aside class="side rv d2">
      <div class="pricecard"><h3>Приёмы и услуги</h3><p class="dt">{d.r}</p>
        {rows.length > 0 ? rows.slice(0, 5).map((r) => <div class="prow"><span><b>{r[0]}</b></span><span class="pv">{r[2]}</span></div>) : <div class="prow"><span><b>Первичный приём</b></span><span class="pv">{d.price || 'по запросу'}</span></div>}
        <button class="btn btn-primary" data-book data-svc={`Приём · ${d.n}`} style="width:100%;margin-top:18px">Записаться</button>
        <p style="margin:12px 0 0;font-size:12px;color:var(--faint);font-weight:600">Полный прайс — на странице <a href="/prices" style="color:var(--blue-600)">Цены</a>.</p></div>
      {d.kids && <div class="card" style="padding:20px;background:#FFF4D6;border-color:transparent"><b style="font-size:14px">Принимает детей</b><p style="margin:6px 0 10px;font-size:13.5px;font-weight:500;color:#7A4B00">{d.kidsRole}</p><a class="btn btn-line sm" href="/kids">Interna KIDS →</a></div>}
    </aside>
  </div></div></section>
  {rel.length > 0 && <section class="sec" style="padding-top:0"><div class="shell"><div class="sec-head rv"><div><p class="kicker">Коллеги</p><h2 class="h">Врачи того же <em>направления</em></h2></div><a class="btn btn-line" href="/doctors">Все врачи →</a></div><div class="grid4">{rel.map((x, i) => <DoctorCard d={x} delay={i + 1} />)}</div></div></section>}
  <Cta />
</Base>
