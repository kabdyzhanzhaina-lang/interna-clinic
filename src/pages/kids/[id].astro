---
// Детское направление (макет 22): подменю, персиковый хиро с ценой и иллюстрацией, факты, описание, «С чем приходят», врач, три шага, другие направления, CTA
import Base from '../../layouts/Base.astro';
import SubNav from '../../components/SubNav.astro';
import Facts from '../../components/Facts.astro';
import SecHead from '../../components/SecHead.astro';
import Body from '../../components/Body.astro';
import Cta from '../../components/Cta.astro';
import kids from '../../data/kids.json';
import doctorsFile from '../../data/doctors.json';
import { img } from '../../lib/site.js';
const doctors = doctorsFile.items.filter((d) => !d.hidden);

export function getStaticPaths() { return kids.services.map((s) => ({ params: { id: s.id } })); }
const s = kids.services.find((x) => x.id === Astro.params.id);
// врачи по ключевому слову направления
const KEY = [[/эндокринолог|диабет/i, /эндокринолог/i], [/гастроэнтеролог/i, /гастроэнтеролог/i], [/педиатр/i, /педиатр/i], [/диетолог/i, /диетолог/i], [/ревматолог/i, /ревматолог/i], [/гематолог/i, /гематолог/i], [/гинеколог/i, /гинеколог/i], [/кардиолог/i, /кардиолог/i], [/аллерголог/i, /аллерголог/i], [/нефролог/i, /нефролог/i], [/инфекционист/i, /инфекционист/i], [/эгдс|колоноскоп|капсульн|импеданс/i, /эндоскопист/i], [/фиброскан/i, /ультразвуков/i]];
const rule = KEY.find(([k]) => k.test(s.t));
const rel = doctors.filter((d) => d.kids && rule && rule[1].test(d.kidsRole || d.r));
const doc = rel[0]; // врача другого профиля не подставляем
const others = kids.services.filter((x) => x.id !== s.id);
const first = (s.body.find((b) => b[0] === 'p') || ['', ''])[1];
// подзаголовок — целыми предложениями, до ~220 символов
const lead = first.split(/(?<=\.)\s+/).reduce((acc, sent) => (acc.length + sent.length <= 220 || !acc ? (acc ? acc + ' ' + sent : sent) : acc), '');
const ul = (s.body.find((b) => b[0] === 'ul') || ['', []])[1];
const reasons = ul.slice(0, 4);
// описание без повторов: начало первого абзаца уже стоит в хиро (lead), а первый список (до 4 пунктов) — карточками «С чем приходят»
const body = s.body.flatMap((b, i, all) => {
  if (b === s.body.find((x) => x[0] === 'p')) { const restP = b[1].slice(lead.length).trim(); return restP ? [['p', restP]] : []; }
  if (b[0] === 'ul' && b[1] === ul && ul.length <= 4) return [];
  const next = all[i + 1];
  if (next && next[0] === 'ul' && next[1] === ul && ul.length <= 4 && (b[0] === 'h3' || (b[0] === 'p' && /:\s*$/.test(b[1])))) return [];
  return [b];
});
const icons = ['height', 'endocrinology', 'monitor_heart', 'child_care'];
const ini = (n) => n.split(' ').slice(0, 2).map((w) => w[0]).join('');
const nav = [['Interna KIDS', '/kids'], ...others.slice(0, 5).map((o) => [o.t, `/kids/${o.id}`]), [s.t, `/kids/${s.id}`]];
const bgs = ['mint', 'ice', 'peach', 'ice50'];
const isSchool = /школ/i.test(s.t);
const isProc = /ЭГДС|колоноскоп|эндоскоп|импеданс|фиброскан/i.test(s.t);
---
<Base og="kids" title={`${s.full} — детская клиника Interna KIDS, Алматы`} description={first.slice(0, 160)} active="kids">
  <SubNav items={nav} active={nav.length - 1} />

  <section class="khero"><div class="shell"><div class="row">
    <div class="info">
      <p class="crumbs rise d1"><a href="/kids">Interna KIDS</a><span class="msr">chevron_right</span><span>{s.t}</span></p>
      <h1 class="rise d2">{s.t}</h1>
      <p class="sub rise d3">{lead}</p>
      <div class="price rise d3"><span class="p">{s.price || 'по запросу'}</span><span class="l">{isSchool ? 'групповые занятия, 3 дня' : isProc ? 'исследование' : 'первичный приём'}</span></div>
      <div class="btns rise d4"><a class="btn btn-primary" href="#" data-book data-svc={s.t}>Записать ребёнка</a><a class="btn btn-wa" href="#" data-wa={`Здравствуйте! Хочу записать ребёнка: ${s.t}.`}><span class="msr">chat</span>Спросить в WhatsApp</a></div>
      {s.note && <p class="note rise d5"><span class="msr">info</span><span>{s.note}</span></p>}
    </div>
    <div class="visual rise d3"><img src={s.icon} alt={s.t} width="260" height="260" /></div>
  </div></div></section>

  <section style="padding:48px 0 0"><div class="shell"><Facts serif md items={[[`${kids.services.length}`, 'детских направлений'], [`${doctors.filter((d) => d.kids).length}`, 'детских врачей']]} /></div></section>

  <section id="about" style="padding:96px 0 0"><div class="shell"><div class="lay g64">
    <div class="main">
      <SecHead eyebrow="Описание" title={s.full} />
      <div class="body kbody rv"><Body body={body} /></div>
    </div>
  </div></div></section>

  {reasons.length > 0 && <section style="padding:96px 0 0"><div class="shell">
    <SecHead eyebrow={isSchool ? 'Программа' : 'Когда записаться'} title={isSchool ? 'Что вы узнаете' : /(лог|иатр|ист)$/.test(s.t) ? `С чем приходят к ${s.t.toLowerCase().replace(/^детский /, 'детскому ').replace(/лог$/, 'логу').replace(/педиатр$/, 'педиатру').replace(/ист$/, 'исту')}` : 'Показания'} />
    <div class="grid4">{reasons.map((r, i) => <div class={`icard big rv d${i + 1}`}><span class="msr">{icons[i]}</span><p>{r}</p></div>)}</div>
  </div></section>}

  {doc && <section style="padding:96px 0 0"><div class="kdoc"><div class="shell">
    <SecHead eyebrow="Кто принимает" title="Врач направления" />
    <a class="docrow big rv" href={`/doctor/${doc.id}`}>
      <span class="ph">{doc.img ? <img src={img(doc.img)} alt={doc.n} loading="lazy" /> : <span class="ini">{ini(doc.n)}</span>}</span>
      <span class="i"><b>{doc.n}</b><small>{doc.kidsRole || doc.r}</small><span class="tags"><span>Interna KIDS</span>{doc.exp && <span>стаж {doc.exp}</span>}<span>приём очно</span></span></span>
      <span class="btn btn-line" data-book data-svc={s.t}>Записаться</span>
      <span class="msr ai">arrow_forward</span>
    </a>
  </div></div></section>}


  <section style="padding:96px 0 0"><div class="shell">
    <SecHead eyebrow="Interna KIDS" title="Другие детские направления" link={[`Все ${kids.services.length} направлений`, '/kids#services']} />
    <div class="grid4">{others.slice(0, 4).map((o, i) => <a class={`kcard ${bgs[i]} rv d${i + 1}`} href={`/kids/${o.id}`}><img src={o.icon} alt="" width="72" height="72" loading="lazy" /><b>{o.t}</b><small>{o.price ? `от ${o.price}` : 'цена по запросу'}</small><span class="link">Подробнее <span class="msr">arrow_forward</span></span></a>)}</div>
  </div></section>

  <Cta title={`Запишите ребёнка к ${isSchool ? 'нам в школу диабета' : 'детскому специалисту'}`} text="Администратор подтвердит время приёма." svc={s.t} />
</Base>
