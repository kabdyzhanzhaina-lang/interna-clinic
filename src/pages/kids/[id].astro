---
// Страница детской услуги Interna KIDS — текст из каталога старого сайта
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import DoctorCard from '../../components/DoctorCard.astro';
import Body from '../../components/Body.astro';
import Cta from '../../components/Cta.astro';
import kids from '../../data/kids.json';
import doctors from '../../data/doctors.json';

export function getStaticPaths() { return kids.services.map((s) => ({ params: { id: s.id } })); }
const s = kids.services.find((x) => x.id === Astro.params.id);
// врачи по ключевому слову направления
const KEY = [[/эндокринолог|диабет/i, /эндокринолог/i], [/гастроэнтеролог/i, /гастроэнтеролог/i], [/педиатр/i, /педиатр/i], [/диетолог/i, /диетолог/i], [/ревматолог/i, /ревматолог/i], [/гематолог/i, /гематолог/i], [/гинеколог/i, /гинеколог/i], [/кардиолог/i, /кардиолог/i], [/аллерголог/i, /аллерголог/i], [/нефролог/i, /нефролог/i], [/инфекционист/i, /инфекционист/i], [/эгдс|колоноскоп|капсульн|импеданс/i, /эндоскопист/i], [/фиброскан/i, /ультразвуков/i]];
const rule = KEY.find(([k]) => k.test(s.t));
const rel = doctors.filter((d) => d.kids && rule && rule[1].test(d.kidsRole || d.r)).slice(0, 4);
const others = kids.services.filter((x) => x.id !== s.id).slice(0, 8);
const lead = (s.body.find((b) => b[0] === 'p') || ['', ''])[1];
---
<Base title={`${s.full} — детская клиника Interna KIDS, Алматы`} description={lead.slice(0, 160)} theme="kids" active="kids">
  <PageHero crumbs={[['Главная', '/'], ['Interna KIDS', '/kids'], [s.t]]} title={s.t} sub={lead.slice(0, 200)} chips={['Interna KIDS', s.price || 'цена по запросу']} theme="kidshero">
    <div slot="deco">{s.icon && <img src={s.icon} alt="" style="position:absolute;right:8%;top:140px;width:140px;height:140px;opacity:.9" data-parallax="0.15" data-rotate="0.04" />}</div>
  </PageHero>
  <section class="sec"><div class="shell"><div class="article">
    <article class="body rv">
      {s.note && <div class="knote" style="margin-bottom:22px"><span>ℹ️</span><span>{s.note}</span></div>}
      <Body body={s.body.slice(1)} />
    </article>
    <aside class="side rv d2">
      <div class="pricecard"><h3>Стоимость</h3><p class="dt">{s.t}</p>
        <div class="prow"><span><b>Приём</b><small>очно в клинике</small></span><span class="pv">{s.price || 'по запросу'}</span></div>
        <button class="btn btn-primary" data-book data-svc={`Interna KIDS · ${s.t}`} style="width:100%">Записать ребёнка</button>
        <p style="margin:12px 0 0;font-size:12px;color:var(--faint);font-weight:600">Полный прайс детских услуг — на странице <a href="/prices" style="color:var(--blue-600)">Цены</a>.</p></div>
      <div class="toc"><b style="font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);display:block;margin-bottom:10px">Другие направления KIDS</b>{others.map((x) => <a href={`/kids/${x.id}`}>{x.t}</a>)}</div>
    </aside>
  </div></div></section>
  {rel.length > 0 && <section class="sec" style="padding-top:0"><div class="shell"><div class="sec-head rv"><div><p class="kicker">Врачи</p><h2 class="h">Кто <em>принимает</em></h2></div><a class="btn btn-line" href="/kids#kservices">Все направления →</a></div><div class="grid4">{rel.map((d, i) => <DoctorCard d={{ ...d, r: d.kidsRole || d.r }} delay={i + 1} />)}</div></div></section>}
  <Cta title="Запишите <em>ребёнка</em>" text="Подберём врача и удобное время — утром или после школы." />
</Base>
