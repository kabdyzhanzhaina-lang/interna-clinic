---
// Контакты (макет 10): хиро, строки адрес/часы/телефон/почта + карта-карточка, как добраться (3 карточки), три фото, CTA
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import SecHead from '../components/SecHead.astro';
import Cta from '../components/Cta.astro';
import { SITE, img } from '../lib/site.js';
const rows = [
  ['location_on', 'Богенбай батыра, 248', 'Алматы, центр города · рядом остановки общественного транспорта'],
  ['schedule', 'Пн–Пт 08:00–20:00', 'Сб–Вс 09:00–17:00 · приём по записи'],
  ['call', SITE.phone, 'Звонок или WhatsApp — ответим в рабочее время'],
  ['mail', SITE.email, 'Для документов, партнёров и корпоративных запросов'],
];
const hrefs = [SITE.map2gis, null, SITE.phoneHref, `mailto:${SITE.email}`];
const ways = [
  ['directions_car', 'На машине', 'Клиника в центре города с удобными подъездными путями. Условия парковки уточните у администратора при записи.'],
  ['directions_bus', 'На транспорте', 'Рядом с клиникой — остановки общественного транспорта. Маршрут удобно построить в 2ГИС по ссылке выше.'],
  ['accessible', 'Доступная среда', 'Если нужна помощь при входе или сопровождение — предупредите администратора при записи, мы встретим вас у входа.'],
];
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalClinic', name: 'Interna Clinic', telephone: SITE.phone, email: SITE.email, address: { '@type': 'PostalAddress', streetAddress: 'ул. Богенбай батыра, 248', addressLocality: 'Алматы', addressCountry: 'KZ' }, openingHours: ['Mo-Fr 08:00-20:00', 'Sa-Su 09:00-17:00'] };
---
<Base og="contacts" title="Контакты — Interna Clinic, Алматы, Богенбай батыра 248" description="Адрес, телефон, WhatsApp и часы работы клиники Interna Clinic. Работаем без выходных." active="contacts" jsonld={jsonld}>
  <PageHero crumbs={[['Контакты']]} title="Контакты" sub="Клиника на Богенбай батыра, 248 — в центре Алматы. Работаем без выходных, приём по записи." />

  <section style="padding:24px 0 0"><div class="shell"><div class="lay g48 cwrap">
    <div class="cinfo rv">
      {rows.map((r, i) => <div class="r"><span class="msr">{r[0]}</span><div class="t">{hrefs[i] ? <a href={hrefs[i]} target={/^http/.test(hrefs[i]) ? '_blank' : undefined} rel={/^http/.test(hrefs[i]) ? 'noopener' : undefined}><b>{r[1]}</b></a> : <b>{r[1]}</b>}<span>{r[2]}</span></div></div>)}
      <div class="btns"><button type="button" class="btn btn-primary" data-book>Записаться на приём</button><a class="btn btn-line" href={SITE.map2gis} target="_blank" rel="noopener">Открыть в 2ГИС</a></div>
    </div>
    <a class="main mapcard rv d2" href={SITE.map2gis} target="_blank" rel="noopener" aria-label="Interna Clinic на карте 2ГИС">
      <span class="blob lav"></span><span class="blob mint"></span>
      <span class="msr">location_on</span><b>Богенбай батыра, 248</b><span class="s">Открыть маршрут в 2ГИС</span>
    </a>
  </div></div></section>

  <section style="padding:72px 0 0"><div class="shell">
    <div class="rv"><SecHead eyebrow="Как добраться" title="Три способа доехать" /></div>
    <div class="grid3 rv d2" style="margin-top:32px">{ways.map((w) => <div class="icard ice"><span class="msr">{w[0]}</span><b>{w[1]}</b><p>{w[2]}</p></div>)}</div>
  </div></section>

  <section style="padding:72px 0 96px"><div class="shell"><div class="cphotos rv">
    {['winter', 'building', 'coats'].map((k, i) => <div class={`ph d${i + 1}`}><img src={img(k)} alt="Клиника Interna Clinic" loading="lazy" /></div>)}
  </div></div></section>

  <Cta title="Ждём вас на Богенбай батыра, 248" text="Позвоните или оставьте заявку — администратор подтвердит время и подскажет, как добраться." />
</Base>
