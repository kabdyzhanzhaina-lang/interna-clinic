---
// Interna KIDS (макет 13): фотохиро, подменю, «Почему KIDS» шагами, 17 направлений строками, детские врачи, баннер школы диабета, CTA
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import SubNav from '../components/SubNav.astro';
import SecHead from '../components/SecHead.astro';
import Steps from '../components/Steps.astro';
import DocRow from '../components/DocRow.astro';
import Cta from '../components/Cta.astro';
import kids from '../data/kids.json';
import doctorsFile from '../data/doctors.json';
const docs = doctorsFile.items.filter((d) => !d.hidden).filter((d) => d.kids).slice(0, 4); // макет 13: четыре врача, остальные — по ссылке «Все врачи KIDS»
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalClinic', name: 'Interna KIDS', description: kids.welcome, medicalSpecialty: 'Pediatric', parentOrganization: { '@type': 'MedicalClinic', name: 'Interna Clinic' } };
---
<Base og="kids" title="Interna KIDS — детская клиника в Алматы" description={`Детское отделение Interna Clinic: ${kids.services.length} направлений — педиатр, детский гастроэнтеролог, эндокринолог, эндоскопия и фиброскан детям. ${kids.welcome}`} active="kids" jsonld={jsonld}>
  <PhotoHero image="hero-kids" pos="80% 30%" eyebrow="Interna KIDS" title="Детское отделение" sub={kids.welcome}>
    <a class="btn btn-ghost" href="#" data-book data-svc="Interna KIDS">Записать ребёнка</a>
    <a class="btn btn-ghost" href="#services">Все направления</a>
  </PhotoHero>
  <SubNav items={[['О KIDS', '#features'], ['Направления', '#services'], ['Врачи', '#docs'], ['Школа диабета', '#school'], ['Подготовка', '/prepare'], ['Цены', '/prices']]} />

  <section id="features" style="padding:96px 0 0"><div class="shell">
    <SecHead eyebrow="Почему Interna KIDS" title="Ребёнку спокойно, родителям понятно" />
    <Steps items={kids.features.map((f) => [f.t, f.d])} />
  </div></section>

  <section id="services" style="padding:96px 0 0"><div class="shell">
    <SecHead eyebrow="Направления" title={`${kids.services.length} детских направлений`} link={['Все направления', '/services']} />
    <div class="ksvc">{kids.services.map((s, i) => <a class={`ks rv d${(i % 4) + 1}`} href={`/kids/${s.id}`}><img src={s.icon} alt="" width="44" height="44" loading="lazy" /><b>{s.t}</b><span class="msr">arrow_forward</span></a>)}</div>
  </div></section>

  <section id="docs" style="padding:96px 0 0"><div class="shell">
    <SecHead eyebrow="Врачи" title="Детские специалисты" link={['Все врачи KIDS', '/doctors']} />
    <div class="cols2">{docs.map((d) => <DocRow d={d} role={d.kidsRole} cat="kids" />)}</div>
  </div></section>

  <section id="school" style="padding:96px 0 0"><div class="shell">
    <div class="banner lav rv">
      <div class="in"><p class="kicker">Школа диабета</p><h2 class="h">Для детей и родителей</h2><p>Как считать хлебные единицы, вводить инсулин и предотвращать гипогликемию. Групповые занятия для детей и родителей, курс 3 дня.</p><div class="btns"><a class="btn btn-dark" href="#" data-book data-svc="Школа диабета">Записаться в группу</a><a class="link" href="/kids/shkola-diabeta-dlya-detei-i-roditelei">Подробнее о школе <span class="msr">arrow_forward</span></a></div></div>
      <div class="img" style="background-image:url(/images/heart.webp)" role="img" aria-label="Interna KIDS"></div>
    </div>
  </div></section>

  <Cta title="Записать ребёнка на приём" text="Администратор подтвердит время приёма." svc="Interna KIDS" />
</Base>
