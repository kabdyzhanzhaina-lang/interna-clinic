---
// 404 (макет 24): пастельные пятна, курсивная цифра, поиск с тёмной кнопкой и ссылки на разделы
import Base from '../layouts/Base.astro';
import SearchBar from '../components/SearchBar.astro';
---
<Base title="Страница не найдена — Interna Clinic" description="Такой страницы нет. Перейдите на главную или в раздел услуг.">
  <section class="nf">
    <div class="blobs" aria-hidden="true"><i class="blob b1"></i><i class="blob b2"></i><i class="blob b3"></i></div>
    <div class="n rise d1">404</div>
    <h1 class="rise d2">Такой страницы нет</h1>
    <p class="rise d3">Возможно, адрес изменился при обновлении сайта. Попробуйте поиск или перейдите в нужный раздел.</p>
    <div class="rise d3" style="width:100%;display:flex;justify-content:center"><SearchBar dark placeholder="Услуга, врач или симптом" /></div>
    <div class="links rise d4"><a class="link" href="/">На главную <span class="msr">arrow_forward</span></a><a class="link" href="/services">Услуги <span class="msr">arrow_forward</span></a><a class="link" href="/doctors">Врачи <span class="msr">arrow_forward</span></a><a class="link" href="/contacts">Контакты <span class="msr">arrow_forward</span></a></div>
  </section>
</Base>
