---
// О клинике (макет 09): фото-хиро, подменю, факты, миссия, история, оборудование, команда, лицензии, CTA
import Base from '../layouts/Base.astro';
import PhotoHero from '../components/PhotoHero.astro';
import SubNav from '../components/SubNav.astro';
import Facts from '../components/Facts.astro';
import SecHead from '../components/SecHead.astro';
import Cta from '../components/Cta.astro';
import doctorsFile from '../data/doctors.json';
import equipment from '../data/equipment.json';
import { SITE, img } from '../lib/site.js';
const doctors = doctorsFile.items.filter((d) => !d.hidden);
const plural = (n, a, b, c) => { const m = n % 100, k = n % 10; return m > 10 && m < 20 ? c : k === 1 ? a : k > 1 && k < 5 ? b : c; };
const docWord = plural(doctors.length, 'врач', 'врача', 'врачей');
const timeline = [
  ['2022', 'Открытие Interna Clinic', 'Все необходимые специалисты и обследования в одной клинике.'],
  ['Сегодня', 'Оборудование экспертного класса', 'Японское, корейское и европейское оборудование 2023–2024 годов выпуска.'],
];
const eq = ['evis-x1', 'fibroscan-630-exp', 'ge-logiq-e10s', 'inbody770', 'ge-versana-premier'].map((id) => equipment.items.find((e) => e.id === id)).filter(Boolean);
const eqDesc = { 'evis-x1': 'Эндоскопическая видеосистема с режимами NBI и TXI', 'fibroscan-630-exp': 'Эластометрия печени без прокола за несколько минут', 'ge-logiq-e10s': 'УЗИ экспертного класса с поддержкой ИИ', inbody770: 'Анализ состава тела: жир, мышцы, вода', sudoscan: 'Ранняя диагностика диабетической нейропатии', 'ge-versana-premier': 'УЗИ для рутинной и детской диагностики' };
---
<Base og="about" title="О клинике — Interna Clinic, институт гастроэнтерологии, гепатологии и метаболизма" description="Первая клиника доказательной медицины внутренних болезней в Центральной Азии. Оборудование экспертного класса, профессура, лицензия." active="about">
  <PhotoHero image="building" eyebrow="Институт гастроэнтерологии, гепатологии и метаболизма" title="О клинике" sub="Приём, обследование и стационар — в одной клинике на Богенбай батыра, 248.">
    <a class="btn btn-ghost" href="/doctors">Наши врачи</a><a class="btn btn-ghost" href="#equip">Оборудование</a>
  </PhotoHero>
  <SubNav items={[['История', '#history'], ['Миссия', '#mission'], ['Команда', '#team'], ['Оборудование', '#equip'], ['Стационар', '/uslugi/station'], ['Лицензии', '#license'], ['Вакансии', '/vacancies']]} />

  <section style="padding:48px 0 0"><div class="shell">
    <Facts items={[['2022', 'год открытия клиники'], [`${doctors.length}`, `${docWord}, 18 направлений`], ['08:00–22:00', 'по будням, в выходные — до 17:00'], ['7 дней', 'в неделю принимаем пациентов']]} />
  </div></section>

  <section id="mission" style="padding:96px 0 0"><div class="shell"><div class="mission">
    <div class="rv"><p class="kicker">Миссия</p><blockquote class="q">«Мы даём пациенту уверенность: точный диагноз, понятный путь лечения и команду специалистов, работающих вместе ради его здоровья.»</blockquote><p class="who">Принципы Interna Clinic</p></div>
    <div class="im rv d2"><img src={img('team-doctors')} alt="Врачи Interna Clinic" loading="lazy" /></div>
  </div></div></section>

  <section id="history" style="padding:96px 0 0"><div class="shell">
    <div class="hist"><SecHead eyebrow="История" title="Как развивается клиника" />
    <div class="tline">{timeline.map((t, i) => <div class={`y rv d${i + 1}`}><span class="yr">{t[0]}</span><b>{t[1]}</b><p>{t[2]}</p></div>)}</div></div>
  </div></section>

  <section id="equip" style="padding:96px 0 0"><div class="shell">
    <SecHead eyebrow="Оборудование" title="Оборудование экспертного класса" link={['Всё оборудование', '/services']} />
    <div class="eqgrid2">{eq.map((e, i) => <div class={`eq rv d${(i % 3) + 1}`}><div class="im"><img src={e.img} alt={e.name} loading="lazy" /></div><b>{e.name}</b><p>{eqDesc[e.id] || e.kind}</p></div>)}</div>
  </div></section>

  <section id="team" style="padding:96px 0 0"><div class="shell">
    <div class="teamcard rv"><div class="bg" style={`background-image:url(${img('team-about')});background-position:64% center`}></div>
      <p class="kicker on-dark">Команда</p><h2>Кандидаты и доктора наук, профессура</h2><p>Индивидуальный разбор каждого случая и личный координатор на каждом этапе обследования.</p><a class="link w" href="/doctors">Все врачи <span class="msr">arrow_forward</span></a></div>
  </div></section>

  <section id="license" style="padding:48px 0 96px"><div class="shell"><div class="grid3">
    <div class="icard rv d1"><span class="msr">verified</span><b>Лицензия {SITE.license}</b><p>{SITE.legalName} · БИН {SITE.bin}.</p></div>
    <div class="icard rv d2"><span class="msr">apartment</span><b>Все услуги в одной клинике</b><p>Приём, эндоскопия, УЗИ, лаборатория, дневной и круглосуточный стационар.</p></div>
    <a class="icard rv d3" href="/vacancies"><span class="msr">work</span><b>Вакансии</b><p>Открытые позиции и контакты для резюме.</p><span class="link">Смотреть вакансии <span class="msr">arrow_forward</span></span></a>
  </div></div></section>

  <Cta title="Приходите познакомиться" text="Врач разберёт жалобы и назначит необходимые исследования." />
</Base>
