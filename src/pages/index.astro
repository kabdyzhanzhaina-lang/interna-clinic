---
// Главная (макет 01 Главная / 16 Главная·Mobile): хиро с карточкой поиска, три карточки «В чём мы сильны»,
// направления списком, врачи в две колонки, новости + события, CTA. Анимации: Ken Burns + параллакс фона, rise/rv-reveal.
import Base from '../layouts/Base.astro';
import SecHead from '../components/SecHead.astro';
import DocRow from '../components/DocRow.astro';
import Cta from '../components/Cta.astro';
import doctorsFile from '../data/doctors.json';
import newsFile from '../data/news.json';
import checkupsFile from '../data/checkups.json';
import reviewsFile from '../data/reviews.json';
import { img, SITE } from '../lib/site.js';
import { fmtDate } from '../lib/media.js';

const all = doctorsFile.items.filter((d) => !d.hidden);
const byId = (id) => all.find((d) => d.id === id);
const cols = [[byId('nersesov'), byId('shamshidinova')], [byId('raisova'), byId('kontorshchikov')]].map((c) => c.filter(Boolean));
const cap = (s) => s.charAt(0).toUpperCase() + s.slice(1);
const news = (newsFile.items || newsFile).slice(0, 4);

const best = [
  ['Эндоскопия', 'Колоноскопия и ЭГДС во сне', 'Olympus EVIS X1 экспертного класса. Биопсия и удаление полипов во время исследования, заключение — сразу после процедуры.', '/service/colonoscopy', 'sedation'],
  ['Гепатология', 'Печень под контролем профессора', 'Фиброскан, УЗИ и анализы за один визит. Лечение гепатитов и НАЖБП по международным протоколам.', '/service/fibroscan', 'fibroscan'],
  ['Check-up', 'Полное обследование за 1–2 дня', '5 программ: от базового до расширенного. Личный координатор на каждом этапе.', '/checkup', 'team'],
];
const dirs = [
  ['gastroenterology', 'Гастроэнтерология', 'Боли, вздутие, изжога, СРК, болезнь Крона', '/service/gastro'],
  ['water_drop', 'Гепатология', 'Гепатиты B и C, жировая болезнь печени, цирроз', '/service/fibroscan'],
  ['biotech', 'Эндоскопия', 'Колоноскопия, ЭГДС, видеокапсула, pH-метрия', '/service/colonoscopy'],
  ['radiology', 'УЗИ и диагностика', 'Эластометрия, ЭхоКГ, УЗДГ, InBody, Sudoscan', '/service/ultrasound'],
  ['endocrinology', 'Эндокринология', 'Щитовидная железа, диабет, вес и обмен веществ', '/service/endo'],
  ['child_care', 'Interna KIDS', '17 детских направлений в том же здании', '/kids'],
];
const popular = ['Колоноскопия во сне', 'Гастроэнтеролог', 'Фиброскан', 'Check-up', 'ОСМС'];
// Программы check-up (макет CheckupSec): три карточки — название и цена из данных, три главных пункта программы
// на главной — программы с заполненной карточкой «home» (eb — надпись сверху, hi — 3 пункта)
const cuProgs = checkupsFile.programs.filter((p) => p.home?.hi?.length).slice(0, 3).map((p) => ({ ...p, eb: p.home.eb, hi: p.home.hi }));
// Отзывы (макет ReviewsSec): три первых отзыва, цитата обрезается по границе предложения
const srcOf = (r) => (/2ГИС/i.test(r.src) ? '2ГИС' : /google/i.test(r.src) ? 'Google' : r.src);
const topicOf = (s) => (/эндоскоп|гастроскоп|колоноскоп|ЭГДС|ФГДС/i.test(s) ? 'Эндоскопия' : /печен|гепат|фиброскан/i.test(s) ? 'Гепатология' : /стационар|палат|лежал/i.test(s) ? 'Стационар' : /ребён|ребен|дет|сын|доч/i.test(s) ? 'Interna KIDS' : 'Приём');
const quote = (s, max = 230) => { if (s.length <= max) return s; const cut = s.slice(0, max); const i = Math.max(cut.lastIndexOf('. '), cut.lastIndexOf('! ')); return i > 80 ? cut.slice(0, i + 1) : cut.replace(/\s+\S*$/, '') + '…'; };
const revs = reviewsFile.items.slice(0, 3);
---
<Base title="Медицинский центр в Алматы — Interna Clinic" description="Interna Clinic — институт гастроэнтерологии, гепатологии и метаболизма в Алматы. Эндоскопия во сне, фиброскан, check-up — всё в одном здании. Запись онлайн." active="" theme="home">
  <section class="hero3" id="hero">
    <div class="bgc" aria-hidden="true"><div class="bg" style={`background-image:url(${img('hero')})`} data-parallax="-0.12"></div></div>
    <div class="in">
      <div class="title">
        <p class="kicker rise d1">Interna Clinic · Алматы · с 2022 года</p>
        <h1 class="rise d1"><em>Забота</em><span class="rw" data-typing="о здоровье|о пациенте|о семье|о будущем"><span class="rw-w">о здоровье</span></span></h1>
        <p class="sub rise d2">Институт гастроэнтерологии, гепатологии и метаболизма. Эндоскопия во сне, фиброскан, check-up — всё в одном здании.</p>
        <div class="hacts rise d2 hide-m"><button class="btn btn-primary" data-book>Записаться на приём</button><a class="btn btn-ghost" href={SITE.phoneHref}>{SITE.phone}</a></div>
      </div>
      <div class="scard rise d3" data-search>
        <div class="stabs" data-stabs>
          <button type="button" class="on" data-ph="Колоноскопия, гастроэнтеролог, боль в животе…">Услуги и симптомы</button>
          <button type="button" data-ph="Фамилия врача или специальность…">Врачи</button>
          <button type="button" class="hide-m" data-ph="Например: ЭГДС цена, check-up">Цены</button>
          <button type="button" class="hide-m" data-ph="Вздутие, изжога, инсулинорезистентность, бариатрия…">Блог</button>
        </div>
        <div class="hs-in">
          <span class="msr" aria-hidden="true">search</span>
          <input type="search" placeholder="Колоноскопия, гастроэнтеролог, боль в животе…" aria-label="Поиск по сайту" autocomplete="off" />
          <button type="button" class="btn btn-dark" data-search-go>Найти</button>
        </div>
        <div class="sres" role="listbox" hidden></div>
        <div class="hs-chips"><span class="lbl">Популярное:</span>{popular.map((p) => <button type="button" class="hs-tag" data-search-q={p}>{p}</button>)}</div>
      </div>
    </div>
  </section>

  <section class="best3"><div class="shell">
    <SecHead eyebrow="В чём мы сильны" title="Первая клиника доказательной медицины в Центральной Азии" link={['Все услуги', '/services']} />
    <div class="bcards">{best.map((b, i) => <a class={`bcard rv d${i + 1}`} href={b[3]}><span class="bg" style={`background-image:url(${img(b[4])})`}></span><span class="eb">{b[0]}</span><b>{b[1]}</b><p>{b[2]}</p><span class="link w">Подробнее <span class="msr">arrow_forward</span></span></a>)}</div>
  </div></section>

  <section class="dirs3"><div class="shell"><div class="g">
    <div class="l rv">
      <p class="kicker">Направления</p>
      <h2 class="h">Один институт — все специалисты по ЖКТ и обмену веществ</h2>
      <p>{all.length} врача, 18 направлений и стационар. Весь цикл — от выявления до лечения — в одном здании.</p>
      <a class="link" href="/services">Все направления <span class="msr">arrow_forward</span></a>
    </div>
    <div class="list rv d2">{dirs.map((d) => <a href={d[3]}><span class="msr ic">{d[0]}</span><span class="i"><b>{d[1]}</b><small>{d[2]}</small></span><span class="msr ai">arrow_forward</span></a>)}</div>
  </div></div></section>

  <section class="docs3"><div class="shell">
    <SecHead eyebrow="Врачи" title="Сегодня принимают" link={[`Все ${all.length} врача`, '/doctors']} />
    <div class="cols2 rv">{cols.map((c) => <div class="doclist">{c.map((d) => <DocRow d={d} role={`${d.r}${d.exp ? ' · ' + d.exp : ''}`} tags={(d.tags || []).filter(Boolean).slice(0, 2).map(cap)} />)}</div>)}</div>
  </div></section>

  <section class="cusec"><div class="shell">
    <SecHead eyebrow="Check-up" title="Программы check-up" link={['Все программы', '/checkup']} />
    <div class="cucards">{cuProgs.map((p, i) => <article class={`cuc rv d${i + 1}${i === 1 ? ' dark' : ''}`}>
      <p class="kicker">{p.eb}</p><b class="t">{p.title}</b><span class="price">{p.price}</span>
      <ul>{p.hi.map((h) => <li><span class="msr">check</span>{h}</li>)}</ul>
      <a class={`btn ${i === 1 ? 'btn-wline' : 'btn-line'}`} href={`/checkup#${p.id}`}>Подробнее</a>
    </article>)}</div>
  </div></section>

  <section class="revsec"><div class="shell">
    <SecHead eyebrow="Отзывы" title="Что говорят пациенты" link={['Все отзывы', '/reviews']} />
    <div class="revcards">{revs.map((r, i) => <article class={`rev rv d${i + 1}${i === 1 ? ' ice' : ''}`}>
      <div class="top"><span class="stars">{[0, 1, 2, 3, 4].map(() => <span class="msr">star</span>)}</span><span class={`src${srcOf(r) === '2ГИС' ? ' gis' : ''}`}>{srcOf(r)}</span></div>
      <p class="q">«{quote(r.text)}»</p>
      <div class="au"><span class="av">{r.name.trim()[0].toUpperCase()}</span><span><b>{r.name}</b><small>{srcOf(r)}  ·  {topicOf(r.text)}</small></span></div>
    </article>)}</div>
  </div></section>

  <section class="newssec"><div class="shell"><div class="g">
    <div class="nl">
      <SecHead eyebrow="Новости" title="Что нового в клинике" link={['Все новости', '/news']} />
      <div class="rows">{news.map((n, i) => <a class={`rv d${i + 1}`} href={n.link || '/news'}><span class="i"><span class="meta">{n.tag}  •  {fmtDate(n.date)}</span><b>{n.title}</b></span><span class="msr ai">arrow_forward</span></a>)}</div>
    </div>
    <aside class="events rv d2">
      <p class="kicker">События</p>
      <b class="t">Школа диабета для детей и родителей</b>
      <p>Ежемесячно, группы по записи. Эндокринолог и диетолог Interna KIDS — о питании, инсулине и жизни без ограничений.</p>
      <span class="when"><span class="msr">event</span>Следующая — 21 ноября, 11:00</span>
      <button class="btn btn-dark" data-book data-svc="Школа диабета">Записаться в группу</button>
    </aside>
  </div></div></section>

  <Cta title="Запишитесь на приём уже сегодня" text="Администратор ответит в течение 10 минут в рабочее время, подберёт врача и пришлёт памятку по подготовке." />
  <script is:inline>
    // вкладки в карточке поиска: меняют подсказку в поле
    (function(){var t=document.querySelector('[data-stabs]');if(!t)return;var inp=t.parentElement.querySelector('input');t.addEventListener('click',function(e){var b=e.target.closest('button');if(!b)return;t.querySelectorAll('button').forEach(function(x){x.classList.toggle('on',x===b);});if(inp){inp.placeholder=b.dataset.ph;inp.focus();}});})();
  </script>
</Base>
