---
// Новости и события (макет 12): хиро с чипами-фильтрами, список новостей со стрелкой, карточки событий справа, CTA
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import newsFile from '../data/news.json';
import eventsFile from '../data/events.json';
const news = newsFile.items.slice().sort((a, b) => (b.date || '').localeCompare(a.date || ''));
const events = eventsFile.items;
const M = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
const fmt = (d) => { const [y, m, day] = d.split('-').map(Number); return `${day} ${M[m - 1]} ${y}`; };
const chips = ['Все', 'Акции', 'Стационар', 'Врачи', 'Школы', 'Медиа'];
const tagOf = (n) => (/акци/i.test(n.tag) ? 'Акции' : /врач/i.test(n.tag) ? 'Врачи' : /школ|подготов/i.test(n.tag) ? 'Школы' : n.tag);
---
<Base og="news" title="Новости и события — Interna Clinic" description="Объявления клиники Interna Clinic: акции, изменения в работе, школы для пациентов и приёмы приглашённых специалистов." active="media">
  <PageHero crumbs={[['Новости и события']]} title="Новости и события" sub="Объявления, акции и школы для пациентов.">
    <div class="chips rise d3" id="newsChips">{chips.map((c, i) => <button type="button" class={`chip${i === 0 ? ' on' : ''}`} data-tag={c}>{c}</button>)}</div>
  </PageHero>

  <section style="padding:24px 0 96px"><div class="shell"><div class="lay g60">
    <div class="main">
      <div class="newsl" id="newsList">
        {news.map((n, i) => (
          <a class={`nrow rv d${(i % 3) + 1}`} href={n.link || '#'} id={n.id} data-tag={tagOf(n)}>
            <span class="i"><span class="meta">{n.tag}{n.date && <>&nbsp;&nbsp;•&nbsp;&nbsp;{fmt(n.date)}</>}</span><b>{n.title}</b><p>{n.text}</p></span>
            <span class="msr ai">arrow_forward</span>
          </a>
        ))}
        <p class="empty" hidden>В этой рубрике пока нет новостей.</p>
      </div>
      <div class="more rv"><button type="button" class="btn btn-line" id="newsMore">Показать ещё</button></div>
    </div>
    <aside class="evs rv d2">
      <p class="kicker">События и школы</p>
      {events.map((e, i) => (
        <div class={`ev${i === 0 ? ' dark' : ''}`} id={e.id}>
          <span class="et">{e.type}</span>
          <b>{e.title}</b>
          <span class="r"><span class="msr">event</span>{e.when}</span>
          <span class="r"><span class="msr">location_on</span>{e.where}</span>
          {e.svc ? <button type="button" class={`btn ${i === 0 ? 'btn-ghost' : 'btn-line'}`} data-book data-svc={e.svc}>{e.cta}</button> : <a class={`btn ${i === 0 ? 'btn-ghost' : 'btn-line'}`} href={e.link}>{e.cta}</a>}
        </div>
      ))}
    </aside>
  </div></div></section>

  <Cta title="Хотите получать объявления?" text="Напишите в WhatsApp — будем присылать акции и даты школ для пациентов." btn="Написать в WhatsApp" />
  <script is:inline>
    (function(){var ch=document.getElementById('newsChips'),list=document.getElementById('newsList');if(!ch||!list)return;var rows=[].slice.call(list.querySelectorAll('.nrow')),empty=list.querySelector('.empty');
      ch.addEventListener('click',function(e){var b=e.target.closest('.chip');if(!b)return;[].forEach.call(ch.children,function(c){c.classList.toggle('on',c===b);});var t=b.dataset.tag,n=0;rows.forEach(function(r){var on=t==='Все'||r.dataset.tag===t;r.hidden=!on;if(on)n++;});empty.hidden=n>0;});
      var m=document.getElementById('newsMore');if(m)m.addEventListener('click',function(){m.textContent='Это все новости';m.disabled=true;});})();
  </script>
</Base>
