---
// Перенесённые со старого сайта услуги и направления (макет 03): фото-хиро, подменю, факты, обзор с полным текстом, показания, шаги, врачи, цены + вопросы, CTA
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import SubNav from '../../components/SubNav.astro';
import Facts from '../../components/Facts.astro';
import SecHead from '../../components/SecHead.astro';
import Steps from '../../components/Steps.astro';
import DocRow from '../../components/DocRow.astro';
import Faq from '../../components/Faq.astro';
import Body from '../../components/Body.astro';
import Cta from '../../components/Cta.astro';
import extra from '../../data/services_extra.json';
import doctorsFile from '../../data/doctors.json';
import { uslugiPrices } from '../../lib/uslugi-prices.js';
import { SITE, img } from '../../lib/site.js';
const doctors = doctorsFile.items.filter((d) => !d.hidden);

export function getStaticPaths() { return Object.keys(extra).map((slug) => ({ params: { slug } })); }
const { slug } = Astro.params;
const s = extra[slug];
// Врачи направления: детские направления — врачи Interna KIDS, ЭРГ — команда со старой страницы, иначе по категории или должности
const kidsRe = { childgastro: /гастроэнтеролог/i, childendo: /эндокринолог/i }[slug];
const ids = { baloon: ['erdalieva-laura-kerimbaevna', 'kontorshchikov'] }[slug];
const kw = (s.h1 + ' ' + slug).toLowerCase();
const catFor = /гастроэнт|гепат|печен|жкт|колоно|эгдс/.test(kw) ? 'gastro' : /эндокрин|диабет|щитовид/.test(kw) ? 'endo' : /кардио|сердц/.test(kw) ? 'cardio' : /эндоскоп|капсул|биопс|ph/.test(kw) ? 'endoscopy' : null;
const stem = s.t.split(' ')[0].slice(0, 6);
const rel = kidsRe ? doctors.filter((d) => d.kids && kidsRe.test(`${d.r} ${d.kidsRole || ''}`)) : ids ? ids.map((id) => doctors.find((d) => d.id === id)).filter(Boolean) : slug === 'hepatologist' ? doctors.filter((d) => /гепатолог/i.test(d.r)) : catFor ? doctors.filter((d) => d.cat === catFor) : doctors.filter((d) => new RegExp(stem, 'i').test(d.r));
const half = Math.ceil(rel.length / 2);
const priceRows = uslugiPrices(slug);
const img0 = { 'Приём врача': 'team-doctors', 'Эндоскопические процедуры': 'sedation', 'УЗИ': 'uzi', 'Стационар': 'building', 'Interna KIDS': 'heart', 'Функциональная диагностика': 'cardio' }[s.cat] || 'hero';
const bgImg = /капсул/i.test(s.t) ? 'hero' : /фибро/i.test(s.t) ? 'fibroscan' : img0;
const body = s.body || [];
const lead = (s.lead || (body.find((b) => b[0] === 'p') || ['', ''])[1] || '').split(/(?<=\.)\s/).slice(0, 2).join(' ').slice(0, 260);
// Показания — только короткие списки под заголовком о симптомах/показаниях (до 8 пунктов); иначе секцию не показываем.
// Список, ушедший в «Когда стоит записаться», и его короткий вводный заголовок из обзора убираем, чтобы не повторять текст дважды.
const lists = []; const used = new Set(); let hd = '', hdi = -1;
body.forEach((b, i) => {
  if (b[0] === 'h' || b[0] === 'h3' || b[0] === 'p') { hd = String(b[1]); hdi = i; return; }
  if ((b[0] !== 'ul' && b[0] !== 'ol') || !/симптом|жалоб|рекомендован|обращаются|при каких заболеван|показания|когда стоит|в каких случаях|признак/i.test(hd) || /противопоказ|стоимост|требуется|получить/i.test(hd)) return;
  if (!b[1].every((x) => typeof x === 'string' && x.length < 140) || lists.length + b[1].length > 8) return;
  lists.push(...b[1]); used.add(i);
  if (hdi >= 0 && (body[hdi][0] !== 'p' || String(body[hdi][1]).length < 160)) used.add(hdi);
});
const indications = lists;
const shown = body.filter((b, i) => !used.has(i));
const bodyRest = shown.length === 1 && shown[0][0] === 'p' && lead.startsWith(String(shown[0][1]).slice(0, 40)) ? [] : shown;
const n = rel.length;
// пометку «по запросу» не ставим (просьба клиники): нет строки в прайсе — нет и факта цены
const facts = [priceRows[0] && !/запрос/i.test(priceRows[0][2]) && [priceRows[0][2], 'стоимость: ' + priceRows[0][0].toLowerCase().split('(')[0].trim().split(' ').slice(0, 4).join(' ')], ['Одна клиника', 'специалисты и диагностика'], ['08:00–22:00', 'Пн–Пт, Сб–Вс 09:00–17:00'], n > 0 && [`${n} ${n % 10 === 1 && n !== 11 ? 'врач' : n % 10 >= 2 && n % 10 <= 4 && (n < 10 || n > 20) ? 'врача' : 'врачей'}`, 'принимают в клинике']].filter(Boolean);
// седация — не приём врача: анестезия во время эндоскопии, шаги — анализы из чек-листа страницы и само исследование
const steps = slug === 'sedation'
  ? [['Запись', 'Позвоните, напишите в WhatsApp или оставьте заявку на сайте.'], ['Анализы', 'Сдайте обязательные анализы и сделайте ЭКГ — чек-лист в обзоре выше.'], ['Подготовка', 'Памятка — на странице «Подготовка к исследованиям».'], ['Исследование', 'Внутривенная анестезия проводится во время видеоколоноскопии или ЭГДС.']]
  : [['Запись', 'Позвоните, напишите в WhatsApp или оставьте заявку на сайте.'], ['Подготовка', 'Если нужна подготовка, памятка — на странице «Подготовка к исследованиям».'], ['Приём', 'Врач уточняет жалобы и назначает необходимые исследования.'], ['Заключение', 'Результаты и план лечения — на очной консультации.']];
const faq = [slug === 'station' && ['Нужно ли направление?', 'Нет. Госпитализация платная, без направления, вне государственной очереди.'], ['Что взять с собой?', 'Удостоверение личности и имеющиеся медицинские документы.'], ['Как оплатить?', 'Наличными или безналичным способом в клинике.']].filter(Boolean);
const t = s.t.toLowerCase();
---
<Base og="services" title={s.title || `${s.h1} — Interna Clinic`} description={s.description || s.lead} active="services">
  <PhotoHero image={bgImg} eyebrow={s.cat} title={s.t} sub={lead}>
    <button class="btn btn-ghost" data-book data-svc={s.t}>Записаться</button><a class="btn btn-ghost" href="#price">Цены и подготовка</a>
  </PhotoHero>
  <SubNav items={[['Обзор', '#overview'], ['Показания', '#indications'], ['Подготовка', '/prepare'], ['Как проходит', '#how'], ['Врачи', '#docs'], ['Цены', '#price'], ['Вопросы', '#faq']]} />

  <section style="padding:48px 0 0"><div class="shell"><Facts items={facts} /></div></section>

  <section id="overview" style="padding:80px 0 0"><div class="shell"><div class="lay ov top">
    <div class="main rv"><p class="kicker">Зачем</p><h2 class="h ov-h">{s.h1}</h2>
      <div class="ov-body body">{bodyRest.length ? <Body body={bodyRest} /> : <p class="ov-p">{lead}</p>}{!bodyRest.length && (s.paragraphs || []).map((p) => <p class="ov-p">{p}</p>)}</div>
      <a class="link" href="/about#equip">Подробнее об оборудовании <span class="msr">arrow_forward</span></a></div>
    <div class="imgcap rv d2 sticky"><div class="im"><img src={img(bgImg)} alt={s.t} loading="lazy" /></div><span class="cap">{SITE.name} — {s.cat.toLowerCase()}, {SITE.address}</span></div>
  </div></div></section>

  {indications.length > 0 && <section id="indications" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Показания" title="Когда стоит записаться" />
    <div class="ind3">{indications.map((c, i) => <div class={`ind rv d${(i % 3) + 1}`}><span class="msr">check_circle</span><span class="i"><b>{c}</b></span></div>)}</div>
  </div></section>}

  <section id="how" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Как проходит" title={slug === 'sedation' ? 'Четыре шага — от записи до исследования' : 'Четыре шага — от записи до заключения'} />
    <Steps items={steps} />
  </div></section>

  {n > 0 && <section id="docs" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Врачи" title="Кто принимает" link={['Все врачи', '/doctors']} />
    <div class="cols2 rv"><div>{rel.slice(0, half).map((d) => <DocRow d={d} />)}</div><div>{rel.slice(half).map((d) => <DocRow d={d} />)}</div></div>
  </div></section>}

  <section id="price" style="padding:80px 0 96px"><div class="shell"><div class="lay g60">
    <div class="pcard w560 rv"><p class="kicker">Стоимость</p>
      {priceRows.length ? priceRows.map((p) => <div class="r"><span>{p[0]}{p[1] && <small> · {p[1].length > 70 ? p[1].slice(0, p[1].lastIndexOf(' ', 70)) + '…' : p[1]}</small>}</span><span>{/запрос/i.test(p[2]) ? '' : p[2]}</span></div>) : <div class="r"><span>{s.t}</span><span></span></div>}
      <div class="b"><button class="btn btn-primary" data-book data-svc={s.t}>{s.cat === 'Приём врача' ? 'Записаться на приём' : 'Записаться'}</button><a class="btn btn-wa" href="#" data-wa={`Здравствуйте! Хочу записаться: ${s.t}.`}><span class="msr">chat</span>Спросить в WhatsApp</a></div>
    </div>
    <div class="main" id="faq"><Faq items={faq} /></div>
  </div></div></section>

  <Cta title={/приём|лог$|ист$|евт$/i.test(s.t) ? 'Запишитесь на приём' : `Записаться: ${s.t}`} text="Позвоните или оставьте заявку — администратор подберёт время и ответит на вопросы." svc={s.t} />
</Base>
