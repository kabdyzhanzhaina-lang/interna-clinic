---
// Перенесённые со старого сайта услуги и направления (макет 03): фото-хиро, подменю, факты, обзор с полным текстом, показания, шаги, врачи, цены + вопросы, CTA
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import SubNav from '../../components/SubNav.astro';
import Facts from '../../components/Facts.astro';
import SecHead from '../../components/SecHead.astro';
import Steps from '../../components/Steps.astro';
import DocRow from '../../components/DocRow.astro';
import Faq from '../../components/Faq.astro';
import Body from '../../components/Body.astro';
import Cta from '../../components/Cta.astro';
import extra from '../../data/services_extra.json';
import doctorsFile from '../../data/doctors.json';
import prices from '../../data/prices.json';
import { SITE, img } from '../../lib/site.js';
const doctors = doctorsFile.items.filter((d) => !d.hidden);

export function getStaticPaths() { return Object.keys(extra).map((slug) => ({ params: { slug } })); }
const { slug } = Astro.params;
const s = extra[slug];
const kw = (s.h1 + ' ' + slug).toLowerCase();
const catFor = /гастро|гепат|печен|жкт|колоно|эгдс/.test(kw) ? 'gastro' : /эндокрин|диабет|щитовид/.test(kw) ? 'endo' : /кардио|сердц/.test(kw) ? 'cardio' : /детск|child/.test(kw) ? 'kids' : /эндоскоп|капсул|биопс|ph|баллон|гастропласт/.test(kw) ? 'endoscopy' : null;
const stem = s.t.split(' ')[0].slice(0, 6);
const rel = (catFor ? doctors.filter((d) => d.cat === catFor) : doctors.filter((d) => new RegExp(stem, 'i').test(d.r))).slice(0, 6);
const half = Math.ceil(rel.length / 2);
const keys = Object.keys(prices);
const priceKey = prices[s.cat] ? s.cat : (keys.find((k) => k.toLowerCase().includes(stem.toLowerCase())) || (/приём/i.test(s.cat) ? 'Приёмы врачей' : /эндоскоп/i.test(s.cat) ? 'Эндоскопия' : /узи/i.test(s.cat) ? 'УЗИ и УЗДГ' : keys[0]));
const rows = (prices[priceKey] || []);
const own = rows.filter((r) => r[0].toLowerCase().includes(stem.toLowerCase()) && r[2] !== 'по запросу');
const priceRows = (own.length ? own : rows.filter((r) => r[2] !== 'по запросу')).slice(0, 4);
const img0 = { 'Приём врача': 'coats', 'Эндоскопические процедуры': 'sedation', 'УЗИ': 'uzi', 'Стационар': 'building', 'Interna KIDS': 'heart', 'Функциональная диагностика': 'cardio' }[s.cat] || 'hero';
const bgImg = /капсул/i.test(s.t) ? 'hero' : /фибро/i.test(s.t) ? 'fibroscan' : img0;
const body = s.body || [];
const lead = (s.lead || (body.find((b) => b[0] === 'p') || ['', ''])[1] || '').split(/(?<=\.)\s/).slice(0, 2).join(' ').slice(0, 260);
const bodyRest = body.length === 1 && body[0][0] === 'p' && lead.startsWith(body[0][1].slice(0, 40)) ? [] : body;
// Показания — только списки под заголовком о симптомах/показаниях; иначе секцию не показываем
const lists = []; let hd = '';
body.forEach((b) => { if (b[0] === 'h' || b[0] === 'h3' || b[0] === 'p') hd = String(b[1]); else if ((b[0] === 'ul' || b[0] === 'ol') && /симптом|жалоб|рекомендован|обращаются|при каких заболеван|показания|когда стоит|признак/i.test(hd) && !/противопоказ|стоимост|требуется|получить/i.test(hd)) lists.push(...b[1]); });
const indications = lists.filter((x) => typeof x === 'string' && x.length < 140).slice(0, 9);
const n = rel.length;
const facts = [[priceRows[0]?.[2] || 'по запросу', priceRows[0] ? 'стоимость: ' + priceRows[0][0].toLowerCase().split('(')[0].trim().split(' ').slice(0, 4).join(' ') : 'стоимость — у администратора'], ['1 визит', 'приём и обследование в один день'], ['с 08:00', 'работаем 7 дней в неделю'], [n ? `${n} ${n === 1 ? 'врач' : n < 5 ? 'врача' : 'врачей'}` : 'Эксперты', n ? 'принимают по направлению' : 'кандидаты и доктора наук']];
const steps = [['Запись', 'Позвоните, напишите в WhatsApp или оставьте заявку на сайте — администратор подберёт время и врача.'], ['Подготовка', 'Если нужна подготовка, памятку пришлём в WhatsApp при записи и ответим на вопросы заранее.'], ['Приём', 'Врач уточняет жалобы, смотрит прошлые результаты и назначает только нужные обследования.'], ['Заключение', 'Результаты и план лечения — на очной консультации, с ответами на все вопросы.']];
const faq = [['Нужно ли направление?', 'Нет, для платного приёма направление не нужно. По ОСМС и ГОБМП — по направлению из поликлиники прикрепления.'], ['Что взять с собой?', 'Удостоверение личности, прошлые выписки и результаты обследований, список постоянно принимаемых лекарств.'], ['Можно ли пройти обследование в тот же день?', 'Да, в большинстве случаев анализы, УЗИ и эндоскопию проводим в день приёма — всё в одном здании.'], ['Как оплатить?', 'Картой, наличными или Kaspi в клинике. Для некоторых услуг доступна рассрочка.']];
const t = s.t.toLowerCase();
---
<Base og="services" title={s.title || `${s.h1} — Interna Clinic`} description={s.description || s.lead} active="services">
  <PhotoHero image={bgImg} eyebrow={s.cat} title={s.t} sub={lead}>
    <button class="btn btn-ghost" data-book data-svc={s.t}>Записаться</button><a class="btn btn-ghost" href="#price">Цены и подготовка</a>
  </PhotoHero>
  <SubNav items={[['Обзор', '#overview'], ['Показания', '#indications'], ['Подготовка', '/prepare'], ['Как проходит', '#how'], ['Врачи', '#docs'], ['Цены', '#price'], ['Вопросы', '#faq']]} />

  <section style="padding:48px 0 0"><div class="shell"><Facts items={facts} /></div></section>

  <section id="overview" style="padding:80px 0 0"><div class="shell"><div class="lay ov top">
    <div class="main rv"><p class="kicker">Зачем</p><h2 class="h ov-h">{s.h1}</h2>
      <div class="ov-body body">{bodyRest.length ? <Body body={bodyRest} /> : <p class="ov-p">{lead}</p>}{!bodyRest.length && (s.paragraphs || []).map((p) => <p class="ov-p">{p}</p>)}</div>
      <a class="link" href="/about#equip">Подробнее об оборудовании <span class="msr">arrow_forward</span></a></div>
    <div class="imgcap rv d2 sticky"><div class="im"><img src={img(bgImg)} alt={s.t} loading="lazy" /></div><span class="cap">{SITE.name} — {s.cat.toLowerCase()}, {SITE.address}</span></div>
  </div></div></section>

  {indications.length > 0 && <section id="indications" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Показания" title="Когда стоит записаться" />
    <div class="ind3">{indications.map((c, i) => <div class={`ind rv d${(i % 3) + 1}`}><span class="msr">check_circle</span><span class="i"><b>{c}</b></span></div>)}</div>
  </div></section>}

  <section id="how" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Как проходит" title="Четыре шага — от записи до заключения" />
    <Steps items={steps} />
  </div></section>

  {n > 0 && <section id="docs" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Врачи" title="Кто принимает" link={['Все врачи', '/doctors']} />
    <div class="cols2 rv"><div>{rel.slice(0, half).map((d) => <DocRow d={d} />)}</div><div>{rel.slice(half).map((d) => <DocRow d={d} />)}</div></div>
  </div></section>}

  <section id="price" style="padding:80px 0 96px"><div class="shell"><div class="lay g60">
    <div class="pcard w560 rv"><p class="kicker">Стоимость</p>
      {priceRows.length ? priceRows.map((p) => <div class="r"><span>{p[0]}{p[1] && <small> · {p[1].slice(0, 60)}</small>}</span><span>{p[2]}</span></div>) : <div class="r"><span>{s.t}</span><span>по запросу</span></div>}
      <div class="b"><button class="btn btn-primary" data-book data-svc={s.t}>Записаться на приём</button><a class="btn btn-wa" href="#" data-wa={`Здравствуйте! Хочу записаться: ${s.t}.`}><span class="msr">chat</span>Спросить в WhatsApp</a></div>
    </div>
    <div class="main" id="faq"><Faq items={faq} /></div>
  </div></div></section>

  <Cta title={`Запишитесь на ${/приём|лог$|ист$/i.test(s.t) ? 'приём' : t}`} text="Позвоните или оставьте заявку — администратор подберёт время и ответит на вопросы в течение 10 минут." svc={s.t} />
</Base>
