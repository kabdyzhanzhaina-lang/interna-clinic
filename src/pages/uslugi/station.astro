---
// Стационар (просьба клиники): два формата — лечебный и диагностический; сравнение, текст лечебного стационара из документа клиники, заведующая, шаги пребывания, check-up в стационаре, цены и вопросы
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import SubNav from '../../components/SubNav.astro';
import Facts from '../../components/Facts.astro';
import SecHead from '../../components/SecHead.astro';
import Steps from '../../components/Steps.astro';
import DocRow from '../../components/DocRow.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import prices from '../../data/prices.json';
import doctorsFile from '../../data/doctors.json';
import { img } from '../../lib/site.js';
const PK = 'Услуги стационара без учёта медикаментов';
const stay = prices[PK].filter((r) => /^Пребывание в стационаре/.test(r[0]));
const treat = stay.filter((r) => !/check-up/.test(r[0]));
const diag = stay.filter((r) => /check-up/.test(r[0]));
const nersesov = doctorsFile.items.find((d) => d.id === 'nersesov');
// Сравнение форматов — только формулировки клиники: документ «Лечебный стационар», страница и прайс check-up
const compare = [
  ['bed', 'Лечебный стационар', 'Лечение по индивидуальному плану', [
    ['Задача', 'Лечение заболеваний внутренних органов по индивидуальному плану'],
    ['Кому', 'Пациентам с заболеваниями ЖКТ и печени, сахарным диабетом, артериальной гипертензией, заболеваниями сердца'],
    ['Наблюдение', 'Круглосуточно; за каждым пациентом закрепляют лечащего гастроэнтеролога'],
    ['При выписке', 'Выписной эпикриз с рекомендациями и папка с результатами исследований'],
    ['Стоимость', 'от 25 000 ₸ за сутки'],
  ], ['Подробнее о лечебном', '#lechebnyi']],
  ['fact_check', 'Диагностический стационар', 'Обследование по программе check-up', [
    ['Задача', 'Обследование по программе check-up'],
    ['Формат', 'С пребыванием в палате и полным сопровождением'],
    ['Длительность', 'Большинство программ — 2–3 дня'],
    ['Итог', 'Итоговое резюме врача: рекомендации по лечению, питанию и дальнейшему наблюдению'],
    ['Палата', 'от 35 000 ₸ за сутки'],
  ], ['Программы check-up', '/checkup#programs']],
];
const steps = [
  ['Госпитализация и первичный осмотр', 'После оформления лечащий врач осматривает пациента и определяет, какие обследования нужны.'],
  ['Обследование и назначение лечения', 'В первый день пациент сдаёт анализы и проходит назначенные инструментальные исследования. После получения результатов лечащий врач составляет план лечения.'],
  ['Врачебный обход и клинический разбор', 'В стационаре проводят обходы с участием доктора медицинских наук, профессора Александра Витальевича Нерсесова. При необходимости профильные специалисты вместе оценивают результаты обследований, уточняют диагноз и определяют дальнейшую тактику лечения.'],
  ['Выписка', 'Пациент получает на руки выписной эпикриз с рекомендациями и папку с результатами всех лабораторных, инструментальных и других исследований, выполненных в стационаре.'],
];
const faq = [
  ['Чем лечебный стационар отличается от диагностического?', 'В лечебном стационаре лечат заболевания внутренних органов по индивидуальному плану под круглосуточным наблюдением. В диагностическом проходят обследование по программе check-up с пребыванием в палате и полным сопровождением.'],
  ['Что нужно для госпитализации?', 'Результат флюорографии. Пациентов оформляют в первой половине дня; точное время прибытия уточняют при согласовании госпитализации.'],
  ['Можно ли госпитализироваться в моём случае?', 'Возможность госпитализации в вашем случае можно уточнить у заведующей приёмным покоем.'],
  ['Нужно ли направление?', 'Нет. Госпитализация платная, без направления, вне государственной очереди.'],
  ['Что взять с собой?', 'Удостоверение личности и имеющиеся медицинские документы.'],
];
---
<Base og="services" title="Стационар в Алматы — лечебный и диагностический | Interna Clinic" description="Лечебный стационар Interna Clinic: лечение заболеваний внутренних органов под круглосуточным наблюдением, от 25 000 ₸ за сутки. Диагностический стационар — check-up с пребыванием в палате." active="services">
  <PhotoHero image="building" eyebrow="Стационар" title="Лечебный и диагностический стационар" sub="Лечение по индивидуальному плану под круглосуточным наблюдением медицинской команды или обследование по программе check-up с пребыванием в палате.">
    <button class="btn btn-ghost" data-book data-svc="Стационар">Записаться</button><a class="btn btn-ghost" href="#difference">Чем отличаются</a>
  </PhotoHero>
  <SubNav items={[['Чем отличаются', '#difference'], ['Лечебный', '#lechebnyi'], ['Кто наблюдает', '#team'], ['Как проходит', '#how'], ['Диагностический', '#diagnostic'], ['Цены', '#price'], ['Вопросы', '#faq']]} />

  <section style="padding:48px 0 0"><div class="shell"><Facts items={[['от 25 000 ₸', 'сутки в лечебном стационаре'], ['24/7', 'наблюдение медицинской команды'], ['2–3 дня', 'большинство программ check-up'], ['Без направления', 'платная госпитализация вне очереди']]} /></div></section>

  <section id="difference" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Два формата" title="Чем отличаются лечебный и диагностический стационар" />
    <div class="stcmp">{compare.map(([ic, k, h, rows, [bt, href]], i) => (
      <div class={`stcard rv d${i + 1}`}>
        <span class="msr">{ic}</span><p class="kicker">{k}</p><b class="h">{h}</b>
        <dl>{rows.map(([dt, dd]) => <div><dt>{dt}</dt><dd>{dd}</dd></div>)}</dl>
        <a class={`btn ${i ? 'btn-primary' : 'btn-line'}`} href={href}>{bt}</a>
      </div>))}</div>
  </div></section>

  <section id="lechebnyi" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Лечебный стационар" title="Лечение заболеваний внутренних органов" />
    <div class="grid2">
      <div class="icard ice big rv d1"><span class="msr">clinical_notes</span><b>Кого мы госпитализируем</b><p>В лечебном стационаре Interna Clinic принимают пациентов с заболеваниями желудочно-кишечного тракта и печени, включая цирроз и гепатиты, в том числе аутоиммунный гепатит. Также в стационаре лечат пациентов с сахарным диабетом, артериальной гипертензией, заболеваниями сердца и другими заболеваниями внутренних органов.</p><p>Возможность госпитализации в вашем случае можно уточнить у заведующей приёмным покоем.</p></div>
      <div class="icard ice big rv d2"><span class="msr">checklist</span><b>Что нужно для госпитализации</b><p>Для госпитализации потребуется результат флюорографии. Пациентов оформляют в первой половине дня. Точное время прибытия уточняют при согласовании госпитализации.</p></div>
    </div>
  </div></section>

  <section id="team" style="padding:80px 0 0"><div class="shell"><div class="lay ov top">
    <div class="main rv"><p class="kicker">Кто наблюдает пациента</p><h2 class="h ov-h">Заведующая и лечащий врач</h2>
      <p class="ov-p">Работу стационара курирует заведующая Нургуль Алдабергеновна Алдабергенова, врач-гастроэнтеролог и гепатолог. За каждым пациентом закрепляют лечащего гастроэнтеролога. Врач следит за изменениями в состоянии пациента, оценивает результаты обследований и при необходимости корректирует лечение.</p></div>
    <div class="rv d2">
      {/* фото заведующей клиника пришлёт — пока инициалы */}
      <div class="docrow zav"><span class="ph ini" aria-hidden="true">АН</span><span class="i"><b>Алдабергенова Нургуль Алдабергеновна</b><small>Врач-гастроэнтеролог, гепатолог</small><span class="tags"><span class="unit">Заведующая стационаром</span></span></span></div>
      {nersesov && <DocRow d={nersesov} role="Врачебные обходы в стационаре" />}
    </div>
  </div></div></section>

  <section id="how" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Как проходит" title="Как проходит пребывание в стационаре" />
    <Steps items={steps} />
  </div></section>

  <section id="diagnostic" style="padding:80px 0 0"><div class="shell"><div class="lay ov top">
    <div class="main rv"><p class="kicker">Диагностический стационар</p><h2 class="h ov-h">Check-up с пребыванием в палате</h2>
      <p class="ov-p">Программу check-up можно пройти амбулаторно — без госпитализации, по согласованному графику — или в стационаре, с пребыванием в палате и полным сопровождением.</p>
      <p class="ov-p">Большинство программ занимают 2–3 дня. В конце врач сводит результаты в итоговое резюме: рекомендации по лечению, питанию и дальнейшему наблюдению. Формат выбирается в заявке на check-up.</p>
      <div class="stbtns"><a class="btn btn-primary" href="/checkup#programs">Программы check-up</a><a class="btn btn-line" href="/checkup-request">Оставить заявку</a></div></div>
    <div class="imgcap rv d2"><div class="im"><img src={img('hero-checkup')} alt="Check-up в Interna Clinic" loading="lazy" /></div><span class="cap">Check-up — полное обследование за 2–3 дня</span></div>
  </div></div></section>

  <section id="price" style="padding:80px 0 96px"><div class="shell"><div class="lay g60">
    <div class="pcard w560 rv"><p class="kicker">Лечебный стационар · сутки</p>
      {treat.map((p) => <div class="r"><span>{p[0].replace(/^Пребывание в стационаре \((.*)\)$/, '$1').replace(/^./, (c) => c.toUpperCase())}</span><span>{p[2]}</span></div>)}
      <p class="kicker" style="margin-top:28px">Диагностический стационар · сутки</p>
      {diag.map((p) => <div class="r"><span>{p[0].replace(/^Пребывание в стационаре \((.*), check-up\)$/, '$1').replace(/^./, (c) => c.toUpperCase())}</span><span>{p[2]}</span></div>)}
      <a class="link blue" style="margin-top:16px" href={`/prices#${encodeURIComponent(PK)}`}>Все цены стационара<span class="msr" aria-hidden="true">arrow_forward</span></a>
      <div class="b"><button class="btn btn-primary" data-book data-svc="Стационар">Записаться</button><a class="btn btn-wa" href="#" data-wa="Здравствуйте! Хочу уточнить госпитализацию в стационар.">
        <span class="msr">chat</span>Спросить в WhatsApp</a></div>
    </div>
    <div class="main" id="faq"><Faq items={faq} /></div>
  </div></div></section>

  <Cta title="Запишитесь в стационар" text="Позвоните или оставьте заявку — администратор ответит на вопросы и согласует время госпитализации." svc="Стационар" />
</Base>
