---
// Вопросы и ответы — перенесены со старого сайта (scripts/migrate-extras.mjs → src/data/faq.json)
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import faq from '../data/faq.json';
import { SITE } from '../lib/site.js';
const plain = (q) => [...q.a, ...(q.list || [])].join(' ');
const faqld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faq.map((q) => ({ '@type': 'Question', name: q.q, acceptedAnswer: { '@type': 'Answer', text: plain(q) } })) };
const half = Math.ceil(faq.length / 2);
---
<Base title="Вопросы и ответы — Interna Clinic" description="Услуги, запись, время работы, цены, обследования до приёма, стационар и детское отделение — ответы на частые вопросы пациентов клиники." jsonld={faqld} active="patients">
  <PageHero crumbs={[['Главная', '/'], ['Вопросы и ответы']]} title="Вопросы и ответы" sub={`Собрали всё, что спрашивают чаще всего. Не нашли своё — напишите в WhatsApp или позвоните ${SITE.phone}, администратор ответит в течение 10 минут.`} chips={[`${faq.length} вопросов`, 'ответы врачей и администраторов']} />
  <section class="sec"><div class="shell">
    <div class="grid2 rv" style="gap:40px;align-items:start">
      {[faq.slice(0, half), faq.slice(half)].map((col, c) => (
        <div class="accordion" data-acc>{col.map((q, i) => <div class={`acc-item${i === 0 && c === 0 ? ' open' : ''}`}><button class="acc-q">{q.q}<span class="acc-ic"></span></button><div class="acc-a" style={i === 0 && c === 0 ? 'height:auto' : ''}>
          {q.a.map((p) => <p>{p}</p>)}
          {q.list && <ul class="alist" style="margin-top:6px">{q.list.map((x) => <li>{x}</li>)}</ul>}
          {/обследования необходимы/i.test(q.q) && <p class="small" style="margin-top:10px"><a href="/prepare" style="color:var(--blue-600);font-weight:700">Памятки по подготовке <span class="msr ai">arrow_forward</span></a></p>}
        </div></div>)}</div>
      ))}
    </div>
  </div></section>
  <Cta title="Не нашли <em>ответ</em>?" text="Напишите в WhatsApp или позвоните — администратор ответит за 10 минут в рабочее время." />
</Base>
