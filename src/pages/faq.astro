---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Cta from '../components/Cta.astro';
import { SITE } from '../lib/site.js';
const items = [
  ['Как записаться на приём?', `Онлайн на сайте, по телефону ${SITE.phone} или в WhatsApp. Подтверждение придёт сразу, памятка по подготовке — вместе с ним.`],
  ['Можно ли пройти приём и обследования за один день?', 'Да, это наш основной формат — «диагноз на первом приёме».'],
  ['Работаете ли вы по выходным?', 'Да: суббота и воскресенье с 09:00 до 17:00.'],
  ['Есть ли приём на казахском языке?', 'Да, приём ведётся на русском и казахском языках.'],
  ['Сколько стоит седация и безопасна ли она?', 'Седация — 25 000 ₸. Препараты короткого действия, анестезиолог рядом всю процедуру, через 30–40 минут вы полностью в норме.'],
  ['Принимаете ли детей?', 'Да, в отделении Interna KIDS: детский гастроэнтеролог, эндокринолог, педиатрические check-up.'],
  ['Можно ли оплатить картой или в рассрочку?', 'Принимаем карты и наличные. Рассрочка на check-up программы — уточняйте у администратора.'],
  ['Как получить результаты и заключение?', 'Заключение — на руки сразу после приёма, дубликат — в WhatsApp. Гистология — через 5–7 дней.'],
];
const faqld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((q) => ({ '@type': 'Question', name: q[0], acceptedAnswer: { '@type': 'Answer', text: q[1] } })) };
---
<Base title="Вопросы и ответы — Interna Clinic" description="Запись, подготовка, седация, оплата, стационар — ответы на частые вопросы пациентов клиники." jsonld={faqld}>
  <PageHero crumbs={[['Главная', '/'], ['Вопросы и ответы']]} title="Вопросы и ответы" sub="Собрали всё, что спрашивают чаще всего. Не нашли своё — напишите в WhatsApp, ответим за 10 минут." chips={['ответ за 10 минут', 'WhatsApp и телефон']} />
  <section class="sec"><div class="shell">
    <div class="grid2 rv" style="gap:40px">
      {[items.slice(0, 4), items.slice(4)].map((col) => (
        <div class="accordion" data-acc>{col.map((q, i) => <div class={`acc-item${i === 0 ? ' open' : ''}`}><button class="acc-q">{q[0]}<span class="acc-ic"></span></button><div class="acc-a" style={i === 0 ? 'height:auto' : ''}><p>{q[1]}</p></div></div>)}</div>
      ))}
    </div>
  </div></section>
  <Cta title="Не нашли <em>ответ</em>?" text="Напишите в WhatsApp или позвоните — администратор ответит за 10 минут в рабочее время." />
</Base>
