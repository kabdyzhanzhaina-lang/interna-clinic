---
// Страница услуги (макет 03): фото-хиро, подменю, факты, обзор с фото, показания, 4 шага, врачи, цены + вопросы, CTA
import Base from '../../layouts/Base.astro';
import PhotoHero from '../../components/PhotoHero.astro';
import SubNav from '../../components/SubNav.astro';
import Facts from '../../components/Facts.astro';
import SecHead from '../../components/SecHead.astro';
import Steps from '../../components/Steps.astro';
import DocRow from '../../components/DocRow.astro';
import Faq from '../../components/Faq.astro';
import Cta from '../../components/Cta.astro';
import services from '../../data/services.json';
import doctorsFile from '../../data/doctors.json';
import { img, SITE } from '../../lib/site.js';
const doctors = doctorsFile.items.filter((d) => !d.hidden);

export function getStaticPaths() { return Object.keys(services).map((slug) => ({ params: { slug } })); }
const { slug } = Astro.params;
const s = services[slug];
const lead = doctors.find((x) => x.id === s.doc);
const catFor = { colonoscopy: 'endoscopy', fgds: 'endoscopy', fibroscan: 'gastro', ultrasound: 'other', gastro: 'gastro', endo: 'endo' }[slug];
const rel = [lead, ...doctors.filter((x) => x.id !== s.doc && (catFor === 'other' ? /ультразвук/i.test(x.r) : x.cat === catFor))].filter(Boolean).slice(0, 6);
const half = Math.ceil(rel.length / 2);
const steps = s.steps.length > 4 ? [s.steps[0], s.steps[2], s.steps[3], s.steps[4]] : s.steps;
const t = s.t.toLowerCase();
// Падежи для заголовков: [зачем нужна…, кто проводит…, запишитесь на…]
const w = { colonoscopy: ['Зачем нужна колоноскопия', 'Кто проводит колоноскопию', 'Запишитесь на колоноскопию'], fgds: ['Зачем нужна ЭГДС', 'Кто проводит ЭГДС', 'Запишитесь на ЭГДС'], fibroscan: ['Зачем нужен фиброскан', 'Кто проводит фиброскан', 'Запишитесь на фиброскан'], ultrasound: ['Зачем нужно УЗИ', 'Кто проводит УЗИ', 'Запишитесь на УЗИ'], gastro: ['Зачем нужен приём гастроэнтеролога', 'Кто принимает', 'Запишитесь на приём'], endo: ['Зачем нужен приём эндокринолога', 'Кто принимает', 'Запишитесь на приём'] }[slug] || [`Зачем нужна ${t}`, 'Кто проводит', 'Запишитесь на приём'];
const jsonld = { '@context': 'https://schema.org', '@type': 'MedicalProcedure', name: s.t, description: s.sub, offers: s.prices.map((p) => ({ '@type': 'Offer', name: p[0], price: p[2].replace(/[^\d]/g, ''), priceCurrency: 'KZT' })) };
const whyP = s.why.split(/(?<=\.)\s+(?=[А-ЯA-Z])/);
const specs = s.equip.specs || [];
// Подготовка (макет Prep): короткие шаги из данных услуги, полная памятка — на /prepare#id
const prep = s.prep;
// Связанные услуги (макет Related): три карточки по полю related
const related = (s.related || []).map((k) => [k, services[k]]).filter(([, x]) => x).slice(0, 3);
const catShort = { 'Эндоскопия': 'Эндоскопия', 'Диагностика': 'Диагностика', 'Приём': 'Консультации' };
---
<Base og="services" title={`${s.h1} — цена, запись | Interna Clinic`} description={s.sub} active="services" jsonld={jsonld}>
  <PhotoHero image={s.img} eyebrow={s.cat} title={s.t} sub={s.sub}>
    <button class="btn btn-ghost" data-book data-svc={s.t}>Записаться</button><a class="btn btn-ghost" href="#price">Цены и подготовка</a>
  </PhotoHero>
  <SubNav items={[['Обзор', '#overview'], ['Показания', '#indications'], ...(prep ? [['Подготовка', '#prep']] : []), ['Как проходит', '#how'], ['Врачи', '#docs'], ['Цены', '#price'], ['Вопросы', '#faq']]} />

  <section style="padding:48px 0 0"><div class="shell"><Facts items={s.facts} /></div></section>

  <section id="overview" style="padding:80px 0 0"><div class="shell"><div class="lay ov">
    <div class="main rv"><p class="kicker">Зачем</p><h2 class="h ov-h">{w[0]}</h2>{whyP.map((p) => <p class="ov-p">{p}</p>)}<a class="link" href="/about#equip">Подробнее об оборудовании <span class="msr">arrow_forward</span></a></div>
    <div class="imgcap rv d2"><div class="im"><img src={img(s.equip.img)} alt={s.equip.n} loading="lazy" /></div><span class="cap">{s.equip.n} — {s.equip.d.split(/(?<=\.)\s/)[0]}</span></div>
  </div></div></section>

  <section id="indications" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Показания" title="Когда стоит записаться" />
    <div class="ind3">{s.checks.map((c, i) => <div class={`ind rv d${(i % 3) + 1}`}><span class="msr">check_circle</span><span class="i"><b>{c}</b></span></div>)}</div>
  </div></section>

  <section id="how" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Как проходит" title={steps.length === 4 ? 'Четыре шага — и вы свободны к обеду' : 'Как проходит визит'} />
    <Steps items={steps.map((st) => [st[0], st[2]])} />
  </div></section>

  {prep && <section id="prep" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Подготовка" title={prep.h} link={['Все памятки', '/prepare']} />
    <div class="prep">
      <ol class="plist rv">{prep.steps.map((st, i) => <li><span class="n">{String(i + 1).padStart(2, '0')}</span><span class="t">{st}</span></li>)}</ol>
      <aside class="pside rv d2"><p class="kicker">Важно</p><b>Администратор пришлёт памятку в WhatsApp при записи и ответит на вопросы по подготовке.</b><p>{prep.note}</p>
        <div class="b"><a class="btn btn-line" href={`/prepare#${prep.memo}`}>Полная памятка</a><a class="btn btn-wa" href="#" data-wa={`Здравствуйте! Вопрос по подготовке: ${s.t}.`}><span class="msr">chat</span>Написать в WhatsApp</a></div>
      </aside>
    </div>
  </div></section>}

  <section id="docs" style="padding:80px 0 0"><div class="shell">
    <SecHead eyebrow="Врачи" title={w[1]} link={['Все врачи', '/doctors']} />
    <div class="cols2 rv"><div>{rel.slice(0, half).map((d) => <DocRow d={d} />)}</div><div>{rel.slice(half).map((d) => <DocRow d={d} />)}</div></div>
  </div></section>

  <section id="price" style="padding:80px 0 96px"><div class="shell"><div class="lay g60">
    <div class="pcard w560 rv"><p class="kicker">Стоимость</p>
      {s.prices.map((p) => <div class="r"><span>{p[0]}{p[1] && <small> · {p[1]}</small>}</span><span>{p[2]}</span></div>)}
      <div class="b"><button class="btn btn-primary" data-book data-svc={s.t}>Записаться на приём</button><a class="btn btn-wa" href="#" data-wa={`Здравствуйте! Хочу записаться: ${s.t}.`}><span class="msr">chat</span>Спросить в WhatsApp</a></div>
    </div>
    <div class="main" id="faq"><Faq items={s.faq} /></div>
  </div></div></section>

  {related.length > 0 && <section id="related" style="padding:0 0 96px"><div class="shell">
    <SecHead eyebrow="Связанные услуги" title="Часто проходят вместе" link={['Все услуги', '/services']} />
    <div class="relcards">{related.map(([k, x], i) => <a class={`relcard rv d${i + 1}`} href={`/service/${k}`}>
      <span class="top"><span class="tile"><span class="msr">{x.icon}</span></span><span class="i"><b>{x.t}</b><small>{catShort[x.cat] || x.cat}</small></span></span>
      <span class="d">{x.short}</span>
      <span class="bot"><span class="pr">{/^от/i.test(x.price) ? x.price : `от ${x.price}`}</span><span class="msr">arrow_outward</span></span>
    </a>)}</div>
  </div></section>}

  <Cta title={w[2]} text="Позвоните или оставьте заявку — администратор подберёт время, пришлёт памятку по подготовке и ответит на вопросы." svc={s.t} />
</Base>
