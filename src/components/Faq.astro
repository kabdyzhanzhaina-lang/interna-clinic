---
// Вопросы (макет FAQ-блока в правой колонке / отдельной секции): айбрау, H 36, аккордеон макета + FAQPage JSON-LD
import Accordion from './Accordion.astro';
const { items, kicker = 'Вопросы', title = 'Частые вопросы' } = Astro.props;
const faq = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((q) => ({ '@type': 'Question', name: q[0], acceptedAnswer: { '@type': 'Answer', text: q[1] } })) };
---
<div class="faqb">
  <div class="rv"><p class="kicker">{kicker}</p><h2 class="h" set:html={title} /></div>
  <Accordion items={items} />
</div>
<script type="application/ld+json" set:html={JSON.stringify(faq)} />
