---
// CTA (макет CTA): по центру, айбрау «Спланируйте визит», H2 46, текст, Button/Primary + Button/Line с телефоном; фон — один тон $ice50
import { SITE } from '../lib/site.js';
interface Props { kicker?: string; title?: string; text?: string; btn?: string; svc?: string; }
const { kicker = 'Спланируйте визит', title = 'Запишитесь на приём', text = 'Позвоните или оставьте заявку — администратор ответит в рабочее время и подберёт удобное время.', btn = 'Записаться на приём', svc } = Astro.props;
---
<section class="cta rv">
  <div class="shell">
    <p class="kicker">{kicker}</p>
    <h2 class="h" set:html={title} />
    <p>{text}</p>
    <div class="row"><button class="btn btn-primary" data-book data-svc={svc}>{btn}</button><a class="btn btn-line hide-m" href={SITE.phoneHref}>{SITE.phone}</a><a class="btn btn-wa hide-d" href="#" data-wa="Здравствуйте! Хочу записаться на приём."><span class="msr">chat</span>Написать в WhatsApp</a></div>
  </div>
</section>
