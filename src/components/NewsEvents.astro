---
// Новости и события на главной — две колонки, как на Samsung Medical Center
import newsFile from '../data/news.json';
import eventsFile from '../data/events.json';
const news = newsFile.items.slice().sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const events = eventsFile.items.slice(0, 3);
const M = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
const fmt = (d) => { const [y, m, day] = d.split('-').map(Number); return `${day} ${M[m - 1]} ${y}`; };
---
<section class="sec"><div class="shell">
  <div class="newsev">
    <div class="news rv">
      <div class="newsev-head"><div><p class="kicker">Новости и объявления</p><h2 class="h">Что нового <em>в клинике</em></h2></div><a class="btn btn-line sm" href="/news">Все новости</a></div>
      <div class="news-list">
        {news.map((n) => (
          <a class="news-item" href={n.link || `/news#${n.id}`}>
            <time datetime={n.date}>{fmt(n.date)}</time>
            <span><span class="tag">{n.tag}</span><b>{n.title}</b><small>{n.text}</small></span>
            <span class="msr ai">arrow_forward</span>
          </a>
        ))}
      </div>
    </div>
    <div class="events rv d2">
      <div class="newsev-head"><div><p class="kicker">События и школы</p><h2 class="h">Куда <em>прийти</em></h2></div></div>
      <div class="ev-list">
        {events.map((e) => (
          <div class="ev-item">
            <span class="ev-type">{e.type}</span>
            <b>{e.title}</b>
            <p class="ev-when"><span class="msr">event</span>{e.when}</p>
            <p class="ev-text">{e.text}</p>
            {e.svc ? <button type="button" class="btn btn-primary sm" data-book data-svc={e.svc}>{e.cta}</button> : <a class="btn btn-line sm" href={e.link}>{e.cta}</a>}
          </div>
        ))}
      </div>
    </div>
  </div>
</div></section>
